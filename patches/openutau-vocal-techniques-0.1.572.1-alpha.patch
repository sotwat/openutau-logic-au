+using System;
+using System.Collections.Generic;
+using System.Linq;
+using OpenUtau.Core.Util;
+
+namespace OpenUtau.Core.Ustx {
+    public class VocalTechniqueState {
+        public List<PitchPoint> original = new();
+        public List<PitchPoint> applied = new();
+        public bool originalSnapFirst;
+        public bool scoop;
+        public bool fall;
+        public bool hammer;
+
+        public VocalTechniqueState Clone() => new() {
+            original = original.Select(p => p.Clone()).ToList(),
+            applied = applied.Select(p => p.Clone()).ToList(),
+            originalSnapFirst = originalSnapFirst,
+            scoop = scoop, fall = fall, hammer = hammer,
+        };
+    }
+
+    public static class VocalTechniques {
+        // Pitch points use tenths of a semitone; times below are milliseconds.
+        private static bool Matches(UPitch pitch) => pitch.techniques is { } state &&
+            !pitch.snapFirst && pitch.data.Count == state.applied.Count &&
+            pitch.data.Zip(state.applied).All(pair =>
+                pair.First.X == pair.Second.X && pair.First.Y == pair.Second.Y &&
+                pair.First.shape == pair.Second.shape);
+
+        public static bool IsEnabled(UPitch pitch, string name) {
+            if (!Matches(pitch)) { return false; }
+            return name switch {
+                "scoop" => pitch.techniques!.scoop,
+                "fall" => pitch.techniques!.fall,
+                "hammer" => pitch.techniques!.hammer,
+                _ => false,
+            };
+        }
+
+        public static UPitch Set(UPitch pitch, double durationMs, string name, bool enabled) {
+            if (name != "scoop" && name != "fall" && name != "hammer") {
+                throw new ArgumentException("Unknown vocal technique", nameof(name));
+            }
+            var state = Matches(pitch) ? pitch.techniques!.Clone() : new VocalTechniqueState {
+                original = pitch.data.Select(p => p.Clone()).ToList(),
+                originalSnapFirst = pitch.snapFirst,
+            };
+            switch (name) {
+                case "scoop": state.scoop = enabled; break;
+                case "fall": state.fall = enabled; break;
+                case "hammer": state.hammer = enabled; break;
+            }
+            if (!state.scoop && !state.fall && !state.hammer) {
+                return new UPitch { data = state.original, snapFirst = state.originalSnapFirst };
+            }
+            float duration = (float)Math.Max(1, double.IsFinite(durationMs) ? durationMs : 1);
+            float scoopEnd = Math.Min(140, duration * .25f);
+            float hammerStep = Math.Min(180, duration * .35f);
+            float hammerEnd = hammerStep + Math.Min(20, duration * .04f);
+            float fallStart = duration - Math.Min(180, duration * .25f);
+            var xs = new SortedSet<float>(state.original.Select(p => p.X)) { 0, duration };
+            // Sample the original curves and each short envelope, keeping long notes bounded.
+            for (int i = 0; i + 1 < state.original.Count; ++i) {
+                var a = state.original[i]; var b = state.original[i + 1];
+                int steps = Math.Clamp((int)Math.Ceiling((b.X - a.X) / 10), 1, 200);
+                for (int j = 1; j < steps; ++j) { xs.Add(a.X + (b.X - a.X) * j / steps); }
+            }
+            void Segment(float a, float b) {
+                xs.Add(a); xs.Add(b);
+                for (float x = a + 10; x < b; x += 10) { xs.Add(x); }
+            }
+            if (state.scoop) { Segment(0, scoopEnd); }
+            if (state.hammer) { Segment(0, hammerStep); Segment(hammerStep, hammerEnd); }
+            if (state.fall) { Segment(fallStart, duration); }
+            float Base(float x) {
+                if (state.original.Count == 0) { return 0; }
+                for (int i = 0; i + 1 < state.original.Count; ++i) {
+                    var a = state.original[i]; var b = state.original[i + 1];
+                    if (a.X <= x && x <= b.X && a.X < b.X) {
+                        return (float)MusicMath.InterpolateShape(a.X, b.X, a.Y, b.Y, x, a.shape);
+                    }
+                }
+                return x < state.original[0].X ? state.original[0].Y : state.original[^1].Y;
+            }
+            float Offset(float x) {
+                if (x < 0) { return 0; }
+                float y = 0;
+                if (state.scoop && x < scoopEnd) {
+                    float t = x / scoopEnd;
+                    y -= 15 * (1 - t) * (1 - t);
+                }
+                if (state.hammer && x < hammerEnd) {
+                    y -= x <= hammerStep ? 10 : 10 * (hammerEnd - x) / (hammerEnd - hammerStep);
+                }
+                if (state.fall && x > fallStart) {
+                    float t = Math.Min(1, (x - fallStart) / (duration - fallStart));
+                    y -= 20 * t * t;
+                }
+                return y;
+            }
+            var result = new UPitch {
+                snapFirst = false,
+                data = xs.Select(x => new PitchPoint(x, Base(x) + Offset(x), PitchPointShape.l)).ToList(),
+                techniques = state,
+            };
+            state.applied = result.data.Select(p => p.Clone()).ToList();
+            return result;
+        }
+    }
+}
