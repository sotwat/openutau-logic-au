+using System;
+using System.Linq;
+using OpenUtau.Core.Ustx;
+using Xunit;
+
+namespace OpenUtau.Core.Util {
+    public class VocalTechniquesTest {
+        private UPitch Original() => new() {
+            snapFirst = true,
+            data = new() { new(-40, 2), new(40, 0), new(300, 3) },
+        };
+        private static void Equal(UPitch a, UPitch b) {
+            Assert.Equal(a.snapFirst, b.snapFirst);
+            Assert.Equal(a.data.Select(p => (p.X, p.Y, p.shape)), b.data.Select(p => (p.X, p.Y, p.shape)));
+        }
+        [Theory]
+        [InlineData("scoop")]
+        [InlineData("fall")]
+        [InlineData("hammer")]
+        public void ToggleRestoresOriginalAndPersists(string name) {
+            var original = Original();
+            var on = VocalTechniques.Set(original, 600, name, true);
+            Assert.True(VocalTechniques.IsEnabled(on, name));
+            Assert.Equal(original.data[0].Y, on.data[0].Y);
+            Assert.Equal(original.snapFirst, on.snapFirst);
+            var restored = Yaml.DefaultDeserializer.Deserialize<UPitch>(Yaml.DefaultSerializer.Serialize(on));
+            Assert.True(VocalTechniques.IsEnabled(restored, name));
+            Equal(original, VocalTechniques.Set(restored, 600, name, false));
+            Equal(original, Original());
+        }
+        [Fact]
+        public void CombinesAndDisablesIndependentlyWithoutAccumulation() {
+            var original = Original();
+            var a = VocalTechniques.Set(original, 600, "scoop", true);
+            var b = VocalTechniques.Set(a, 600, "fall", true);
+            var c = VocalTechniques.Set(b, 600, "hammer", true);
+            Assert.True(VocalTechniques.IsEnabled(c, "scoop"));
+            Assert.True(VocalTechniques.IsEnabled(c, "fall"));
+            var d = VocalTechniques.Set(c, 600, "hammer", false);
+            Equal(b, d);
+            Equal(c, VocalTechniques.Set(c, 600, "hammer", true));
+            Equal(original, VocalTechniques.Set(VocalTechniques.Set(d, 600, "fall", false), 600, "scoop", false));
+        }
+        [Fact]
+        public void ManualEditsBecomeNewBaseline() {
+            var pitch = VocalTechniques.Set(Original(), 600, "scoop", true);
+            pitch.data[2].Y += 3;
+            Assert.False(VocalTechniques.IsEnabled(pitch, "scoop"));
+            var saved = pitch.Clone();
+            Equal(saved, VocalTechniques.Set(VocalTechniques.Set(pitch, 600, "fall", true), 600, "fall", false));
+        }
+        [Fact]
+        public void CloneAndUndoDoNotShareTechniqueState() {
+            var part = new UVoicePart();
+            var note = UNote.Create(); note.pitch = Original();
+            var original = note.pitch.Clone();
+            var command = new SetPitchPointsCommand(part, note, VocalTechniques.Set(note.pitch, 600, "hammer", true));
+            command.Execute();
+            var clone = note.Clone();
+            clone.pitch.techniques!.original[0].Y = 999;
+            Assert.NotEqual(999, note.pitch.techniques!.original[0].Y);
+            command.Unexecute(); Equal(original, note.pitch);
+            command.Execute(); Assert.True(VocalTechniques.IsEnabled(note.pitch, "hammer"));
+        }
+        [Theory]
+        [InlineData(1)] [InlineData(20)] [InlineData(600)] [InlineData(60000)]
+        public void EnvelopesAreFiniteAndOrdered(double duration) {
+            var pitch = new UPitch { data = new() { new(-40, 0), new(40, 0) } };
+            foreach (var name in new[] { "scoop", "fall", "hammer" }) {
+                pitch = VocalTechniques.Set(pitch, duration, name, true);
+            }
