--- /dev/null
+++ b/OpenUtau.Test/Classic/UntunedUstExportTest.cs
@@ -0,0 +1,60 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Text;
+using OpenUtau.Core;
+using OpenUtau.Core.Pipeline;
+using OpenUtau.Core.Ustx;
+using OpenUtau.Core.Util;
+using Xunit;
+
+namespace OpenUtau.Classic {
+    public class UntunedUstExportTest {
+        [Theory]
+        [InlineData(false)]
+        [InlineData(true)]
+        public void ExportKeepsScoreAndDoesNotChangeTuning(bool withoutSinger) {
+            Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
+            var (project, track, part) = PhraseSourceHashTest.BuildFixture();
+            if (withoutSinger) {
+                track.Singer = null;
+                part.phonemes.Clear();
+            }
+            var first = part.notes.First();
+            first.lyric = "きゃ";
+            first.vibrato.length = 65;
+            first.noteGain = 35;
+            project.tempos.Add(new UTempo(part.notes.Last().position, 150));
+            project.timeAxis.BuildSegments(project);
+            var original = Yaml.DefaultSerializer.Serialize(part);
+            var path = Path.Combine(Path.GetTempPath(), $"openutau-flat-{Guid.NewGuid()}.ust");
+            try {
+                Ust.SavePart(project, part, path, untuned: true);
+                var text = File.ReadAllText(path, Encoding.GetEncoding("shift_jis"));
+                Assert.DoesNotContain("PBS=", text);
+                Assert.DoesNotContain("PBW=", text);
+                Assert.DoesNotContain("PBY=", text);
+                Assert.DoesNotContain("VBR=", text);
+                Assert.DoesNotContain("Flags=", text);
+                Assert.Contains("Velocity=100", text);
+                Assert.Contains("Intensity=100", text);
+                Assert.Contains("Modulation=0", text);
+                Assert.Contains("Tempo=150", text);
+                Assert.Contains("Lyric=R", text);
+                using var reader = new StreamReader(path, Encoding.GetEncoding("shift_jis"));
+                var restored = Ust.Load(reader, path);
+                var restoredPart = Assert.IsType<UVoicePart>(Assert.Single(restored.parts));
+                Assert.Equal(part.notes.Select(n => (n.position, n.duration, n.tone, n.lyric)),
+                    restoredPart.notes.Select(n => (n.position, n.duration, n.tone, n.lyric)));
+                Assert.Equal(original, Yaml.DefaultSerializer.Serialize(part));
+                Ust.SavePart(project, part, path);
+                var normal = File.ReadAllText(path, Encoding.GetEncoding("shift_jis"));
+                Assert.Contains("PBS=", normal);
+                Assert.Contains("VBR=65,", normal);
+                Assert.Equal(original, Yaml.DefaultSerializer.Serialize(part));
+            } finally {
+                File.Delete(path);
+            }
+        }
+    }
+}
