+++ b/OpenUtau/Controls/PianoRoll.AutoPitchwriter.cs
@@ -0,0 +1,138 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Text;
+using System.Text.RegularExpressions;
+using System.Threading.Tasks;
+using Avalonia;
+using Avalonia.Automation;
+using Avalonia.Controls;
+using Avalonia.Layout;
+
+namespace OpenUtau.App.Controls {
+    public partial class PianoRoll {
+        private record TemplatePoint(decimal Time, decimal Cents);
+        private record CurveTemplate(int Id, int Block, TemplatePoint[] Points);
+        private readonly Dictionary<int, TemplatePoint[]> curveEdits = new();
+
+        private static List<CurveTemplate> ReadCurveTemplates(string[] blocks) {
+            decimal Number(string value) => string.IsNullOrWhiteSpace(value) ? 0 :
+                decimal.Parse(value, NumberStyles.Float, CultureInfo.InvariantCulture);
+            var templates = new List<CurveTemplate>();
+            for (int i = 0; i < blocks.Length; i++) {
+                string Field(string key) => Regex.Match(blocks[i], $"(?m)^{key}=([^\\r\\n]*)").Groups[1].Value;
+                var start = Field("PBS");
+                if (start.Length == 0 || !int.TryParse(Field("Lyric"), out int id)) { continue; }
+                var pbs = start.Split(';');
+                var widths = Field("PBW").Split(',');
+                var offsets = Field("PBY").Split(',');
+                var points = new TemplatePoint[widths.Length + 1];
+                points[0] = new TemplatePoint(Number(pbs[0]), pbs.Length > 1 ? 10 * Number(pbs[1]) : 0);
+                for (int j = 0; j < widths.Length; j++) {
+                    points[j + 1] = new TemplatePoint(Number(widths[j]), j < offsets.Length ? 10 * Number(offsets[j]) : 0);
+                }
+                templates.Add(new CurveTemplate(id, i, points));
+            }
+            return templates.OrderBy(t => t.Id).ToList();
+        }
+
+        private static void WriteCurveTemplates(string[] blocks, List<CurveTemplate> templates,
+            Dictionary<int, TemplatePoint[]> edits, string path) {
+            string F(decimal value) => value.ToString("0.######", CultureInfo.InvariantCulture);
+            var output = (string[])blocks.Clone();
+            foreach (var template in templates) {
+                if (!edits.TryGetValue(template.Id, out var points) || points.SequenceEqual(template.Points)) { continue; }
+                var block = Regex.Replace(blocks[template.Block], @"(?m)^(PBS|PBW|PBY)=[^\r\n]*\r?\n", "");
+                int newline = block.IndexOf('\n') + 1;
+                block = block.Insert(newline, $"PBS={F(points[0].Time)};{F(points[0].Cents / 10)}\r\n" +
+                    $"PBW={string.Join(",", points.Skip(1).Select(p => F(p.Time)))}\r\n" +
+                    $"PBY={string.Join(",", points.Skip(1).Select(p => F(p.Cents / 10)))}\r\n");
+                output[template.Block] = block;
+            }
+            File.WriteAllText(path, string.Concat(output), Encoding.GetEncoding(932));
+        }
+
+        private Task<Dictionary<int, TemplatePoint[]>?> ChooseCurveTemplates(Window parent, List<CurveTemplate> templates) {
+            var edits = curveEdits.ToDictionary(x => x.Key, x => (TemplatePoint[])x.Value.Clone());
+            var picker = new ComboBox {
+                ItemsSource = templates.Select(t => string.Format(TuneText("candidate"), t.Id, t.Points.Length)).ToArray(),
+                SelectedIndex = 0,
+                HorizontalAlignment = HorizontalAlignment.Stretch,
+            };
+            var rows = new StackPanel { Spacing = 5 };
+            var reset = new Button { Content = TuneText("resetcurve") };
+            var body = new StackPanel { Spacing = 8, Margin = new Thickness(18) };
+            body.Children.Add(new Label { Content = string.Format(TuneText("candidates"), templates.Count), Target = picker });
+            body.Children.Add(picker);
+            body.Children.Add(rows);
+            body.Children.Add(reset);
+
+            var window = new Window {
+                Title = "AutoPitchwriter", Width = 455, SizeToContent = SizeToContent.Height,
+                CanResize = false, WindowStartupLocation = WindowStartupLocation.CenterOwner,
+            };
+            void ShowCandidate() {
+                if (picker.SelectedIndex < 0) { return; }
+                var template = templates[picker.SelectedIndex];
+                var points = edits.TryGetValue(template.Id, out var existing)
+                    ? existing : (TemplatePoint[])template.Points.Clone();
+                rows.Children.Clear();
+                rows.Children.Add(new TextBlock { Text = TuneText("curvetimehelp"), TextWrapping = Avalonia.Media.TextWrapping.Wrap });
+                for (int i = 0; i < points.Length; i++) {
+                    int index = i;
+                    var row = new Grid { ColumnDefinitions = new ColumnDefinitions("30,*,*"), ColumnSpacing = 8 };
+                    var number = new TextBlock { Text = (i + 1).ToString(), VerticalAlignment = VerticalAlignment.Center };
+                    var time = new NumericUpDown {
+                        Minimum = i == 0 ? -3000 : 1, Maximum = 3000, Value = points[i].Time,
+                        Increment = 1, FormatString = "0.######",
+                    };
+                    var pitch = new NumericUpDown {
+                        Minimum = -2400, Maximum = 2400, Value = points[i].Cents,
+                        Increment = 1, FormatString = "0.######",
+                    };
+                    AutomationProperties.SetName(time, string.Format(TuneText(i == 0 ? "curvestart" : "curveinterval"), i + 1));
+                    AutomationProperties.SetName(pitch, string.Format(TuneText("curvepitch"), i + 1));
+                    time.ValueChanged += (_, _) => {
+                        if (time.Value is decimal value) {
+                            points[index] = points[index] with { Time = value };
+                            edits[template.Id] = points;
+                        }
+                    };
+                    pitch.ValueChanged += (_, _) => {
+                        if (pitch.Value is decimal value) {
+                            points[index] = points[index] with { Cents = value };
+                            edits[template.Id] = points;
+                        }
+                    };
+                    Grid.SetColumn(time, 1);
+                    Grid.SetColumn(pitch, 2);
+                    row.Children.Add(number);
+                    row.Children.Add(time);
+                    row.Children.Add(pitch);
+                    rows.Children.Add(row);
+                }
+            }
+            picker.SelectionChanged += (_, _) => ShowCandidate();
+            reset.Click += (_, _) => {
+                edits.Remove(templates[picker.SelectedIndex].Id);
+                ShowCandidate();
+            };
+            var buttons = new StackPanel {
+                Orientation = Orientation.Horizontal, Spacing = 8, HorizontalAlignment = HorizontalAlignment.Right,
+            };
+            var cancel = new Button { Content = ThemeManager.GetString("button.cancel"), IsCancel = true };
+            cancel.Click += (_, _) => window.Close(null);
+            var run = new Button { Content = TuneText("run"), IsDefault = true };
+            run.Click += (_, _) => window.Close(edits);
+            buttons.Children.Add(cancel);
+            buttons.Children.Add(run);
+            body.Children.Add(buttons);
+            window.Content = new ScrollViewer { Content = body, MaxHeight = 620 };
+            ShowCandidate();
+            window.Opened += (_, _) => picker.Focus();
+            return window.ShowDialog<Dictionary<int, TemplatePoint[]>?>(parent);
+        }
+    }
+}
