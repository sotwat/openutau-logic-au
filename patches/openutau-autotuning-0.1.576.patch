+        [Fact]
+        public void EnuPitchEditRetainsGainAndTechniqueAndCanBeUndone() {
+            var note = UNote.Create();
+            note.position = 0; note.duration = 480; note.tone = 64; note.lyric = "あ";
+            note.PositionMs = 0; note.EndMs = 500;
+            note.noteGain = 53;
+            note.pitch.AddPoint(new PitchPoint(-25, 0));
+            note.pitch.AddPoint(new PitchPoint(40, 0));
+            note.pitch = VocalTechniques.Set(note.pitch, note.DurationMs, "fall", true);
+            var before = note.pitch;
+            var points = new[] { new[] { -5f, -2f }, new[] { 50f, 1f }, new[] { 490f, 0f } };
+            var tuned = (UPitch)typeof(PianoRoll).GetMethod("BuildTunedPitch", PrivateStatic)!
+                .Invoke(null, new object[] { note, points })!;
+            var command = new SetPitchPointsCommand(new UVoicePart(), note, tuned);
+            command.Execute();
+            Assert.Equal(53, note.noteGain);
+            Assert.Equal(64, note.tone);
+            Assert.Equal(480, note.duration);
