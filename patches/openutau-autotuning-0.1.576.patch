+        [Fact]
+        public void EditedCurveTemplateReachesNativeAutoPitchwriter() {
+            var resources = Environment.GetEnvironmentVariable("OPENUTAU_TEST_AUTOTUNING");
+            if (string.IsNullOrEmpty(resources)) { return; }
+            Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
+            var encoding = Encoding.GetEncoding(932);
+            var temp = Directory.CreateTempSubdirectory();
+            try {
+                var templatePath = Path.Combine(temp.FullName, "pitch.ust");
+                var selection = Path.Combine(temp.FullName, "selection.tmp");
+                void Run(params string[] args) {
+                    var start = new ProcessStartInfo("/bin/sh") { UseShellExecute = false };
+                    start.ArgumentList.Add(Path.Combine(resources, "run.sh"));
+                    start.ArgumentList.Add(args[0]);
+                    start.ArgumentList.Add(Path.Combine(temp.FullName, "data"));
+                    foreach (var arg in args.Skip(1)) { start.ArgumentList.Add(arg); }
+                    using var proc = Process.Start(start)!;
+                    Assert.True(proc.WaitForExit(30000));
+                    Assert.Equal(0, proc.ExitCode);
+                }
+                Run("apw-prepare", templatePath);
+                var blocks = Regex.Split(File.ReadAllText(templatePath, encoding), @"(?m)(?=^\[#)");
+                var reader = typeof(PianoRoll).GetMethod("ReadCurveTemplates", PrivateStatic)!;
+                var writer = typeof(PianoRoll).GetMethod("WriteCurveTemplates", PrivateStatic)!;
+                var templates = (IList)reader.Invoke(null, new object[] { blocks })!;
+                Assert.Equal(45, templates.Count);
+                Array Points(object item) => (Array)item.GetType().GetProperty("Points")!.GetValue(item)!;
+                Assert.Equal(159, templates.Cast<object>().Sum(t => Points(t).Length));
+                var points = (Array)Points(templates[11]!).Clone();
+                var pointType = points.GetType().GetElementType()!;
+                points.SetValue(Activator.CreateInstance(pointType, 123m, -170m), 0);
+                var edits = (IDictionary)Activator.CreateInstance(writer.GetParameters()[2].ParameterType)!;
+                edits.Add(12, points);
+                writer.Invoke(null, new object[] { blocks, templates, edits, templatePath });
+                var changed = Regex.Split(File.ReadAllText(templatePath, encoding), @"(?m)(?=^\[#)");
+                Assert.Single(blocks.Zip(changed).Where(pair => pair.First != pair.Second));
+                var source = "[#SETTING]\nTempo=120\nMode2=True\n" +
+                    string.Concat(new[] { "あ", "い", "う", "え", "お", "か" }.Select((lyric, i) =>
+                        $"[#{i:D4}]\nLength=240\nLyric={lyric}\nNoteNum={60 + i}\nVelocity=100\n"));
+                File.WriteAllText(selection, source, encoding);
+                Run("apw-custom", selection, templatePath);
+                Assert.Contains("PBS=123;-17", File.ReadAllText(selection, encoding));
+            } finally {
+                temp.Delete(true);
+            }
+        }
+
+        [Fact]
+        public void AutoPitchwriterFirstPointSurvivesNoteValidation() {
+            var project = new UProject();
+            project.timeAxis.BuildSegments(project);
+            var track = new UTrack();
+            var part = new UVoicePart();
+            var previous = project.CreateNote();
+            previous.position = 0; previous.duration = 240; previous.tone = 60;
+            var note = project.CreateNote();
+            note.position = 240; note.duration = 240; note.tone = 65;
+            note.Prev = previous;
+            note.pitch.data[0].Y = -12;
+            typeof(PianoRoll).GetMethod("KeepAutoPitchwriterCurve", PrivateStatic)!
+                .Invoke(null, new object[] { new[] { note } });
+            note.Validate(new ValidateOptions(), project, track, part);
+            Assert.False(note.pitch.snapFirst);
+            Assert.Equal(-12, note.pitch.data[0].Y);
+        }
+
+        [Fact]
+        public void NativeAutoPitchwriterRoundTripsSelectedNotes() {
+            var resources = Environment.GetEnvironmentVariable("OPENUTAU_TEST_AUTOTUNING");
+            if (string.IsNullOrEmpty(resources)) { return; }
+            Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
+            var project = new UProject();
+            project.tracks.Add(new UTrack());
+            project.timeAxis.BuildSegments(project);
+            var part = new UVoicePart { trackNo = 0 };
+            var lyrics = new[] { "あ", "きゃ", "う", "え", "お", "か" };
+            for (int i = 0; i < lyrics.Length; i++) {
+                var n = project.CreateNote();
+                n.position = i * 240;
+                n.duration = 240;
+                n.tone = 60 + i;
+                n.lyric = lyrics[i];
+                n.Prev = part.notes.LastOrDefault();
+                if (n.Prev != null) { n.Prev.Next = n; }
+                part.notes.Add(n);
+            }
+            var temp = Directory.CreateTempSubdirectory();
+            try {
+                foreach (var (first, last) in new[] { (0, 5), (1, 4) }) {
+                    var input = Path.Combine(temp.FullName, "selection.tmp");
+                    var selected = part.notes.Skip(first).Take(last - first + 1).ToArray();
+                    var sequence = Ust.WritePlugin(project, part, selected[0], selected[^1], input);
+                    var start = new ProcessStartInfo("/bin/sh") { UseShellExecute = false };
+                    foreach (var arg in new[] { Path.Combine(resources, "run.sh"), "apw",
+                        Path.Combine(temp.FullName, "data"), input }) { start.ArgumentList.Add(arg); }
+                    using var process = Process.Start(start)!;
+                    Assert.True(process.WaitForExit(30000));
+                    Assert.Equal(0, process.ExitCode);
+                    var (removed, added) = Ust.ParsePlugin(project, part, selected[0], selected[^1], sequence, input);
+                    Assert.Equal(selected, removed);
+                    Assert.Equal(selected.Select(n => (n.position, n.duration, n.tone, n.lyric)),
+                        added.Select(n => (n.position, n.duration, n.tone, n.lyric)));
+                    Assert.All(added, n => Assert.True(n.pitch.data.Count >= 2));
+                }
+            } finally {
+                temp.Delete(true);
+            }
+        }
