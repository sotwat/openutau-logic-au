+        public void NotesCanvasTouchPadMagnify(object sender, PointerDeltaEventArgs args) {
+            var control = (Control)sender;
+            var size = control.Bounds.Size;
+            if (size.Width <= 0 || size.Height <= 0 || args.Delta.Y == 0) {
+                return;
+            }
+            var point = args.GetPosition(control);
+            var position = new Point(
+                Math.Clamp(point.X / size.Width, 0, 1),
+                Math.Clamp(point.Y / size.Height, 0, 1));
+            var zoom = args.Delta.Y / 2;
+            int axis = pinchAxisAvailable ? ou_pinch_axis() : 0;
+            if (axis != 2) {
+                ViewModel.NotesViewModel.OnXZoomed(position, zoom);
+            }
+            if (axis != 1) {
+                ViewModel.NotesViewModel.OnYZoomed(position, zoom);
+            }
+            LyricBox?.EndEdit();
+            args.Handled = true;
+        }
