+                if (VocalTechniques.IsEnabled(pitch, "fall") || VocalTechniques.IsEnabled(pitch, "rise")) {
+                    Assert.True(pitch.data[^2].X >= duration * .7 - .001);
+                }
+                foreach (var name in names) { pitch = VocalTechniques.Set(pitch, duration, name, false); }
+                Equal(original, pitch);
+            }
+        }
