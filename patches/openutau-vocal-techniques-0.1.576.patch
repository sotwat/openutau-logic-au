+using System;
+using System.Collections.Generic;
+using System.Linq;
+using OpenUtau.Core.Util;
+
+namespace OpenUtau.Core.Ustx {
+    public class VocalTechniqueState {
+        public List<PitchPoint> original = new();
+        public List<PitchPoint> applied = new();
+        public bool originalSnapFirst;
+        public bool scoop;
+        public bool fall;
+        public bool hammer;
+        public bool pull;
+        public bool overshoot;
+        public bool rise;
+        public float scoopDepth = 150, scoopLength = 140, scoopCurve = 0;
+        public float fallDepth = 200, fallLength = 180, fallCurve = 0;
+        public float hammerDepth = 100, hammerLength = 180, hammerRise = 20;
+        public float pullDepth = 100, pullLength = 180, pullDrop = 20;
+        public float overshootDepth = 35, overshootLength = 100, overshootCurve = 0;
+        public float riseDepth = 100, riseLength = 120, riseCurve = 0;
+
+        public VocalTechniqueState Clone() => new() {
+            original = original.Select(p => p.Clone()).ToList(),
+            applied = applied.Select(p => p.Clone()).ToList(),
+            originalSnapFirst = originalSnapFirst,
+            scoop = scoop, fall = fall, hammer = hammer, pull = pull,
+            overshoot = overshoot, rise = rise,
+            scoopDepth = scoopDepth, scoopLength = scoopLength, scoopCurve = scoopCurve,
+            fallDepth = fallDepth, fallLength = fallLength, fallCurve = fallCurve,
+            hammerDepth = hammerDepth, hammerLength = hammerLength, hammerRise = hammerRise,
+            pullDepth = pullDepth, pullLength = pullLength, pullDrop = pullDrop,
+            overshootDepth = overshootDepth, overshootLength = overshootLength, overshootCurve = overshootCurve,
+            riseDepth = riseDepth, riseLength = riseLength, riseCurve = riseCurve,
+        };
+    }
+
+    public static class VocalTechniques {
+        // Pitch points use tenths of a semitone; times below are milliseconds.
+        private static bool Matches(UPitch pitch) => pitch.techniques is { } state &&
+            pitch.snapFirst == state.originalSnapFirst && pitch.data.Count == state.applied.Count &&
+            pitch.data.Zip(state.applied).Select((pair, index) =>
+                pair.First.X == pair.Second.X &&
+                // UNote.Validate owns the snapped first point's Y, including during playback.
+                (pair.First.Y == pair.Second.Y || index == 0 && pitch.snapFirst) &&
+                pair.First.shape == pair.Second.shape).All(matches => matches);
+
+        public static bool IsActive(UPitch pitch) => Matches(pitch) &&
+            (pitch.techniques!.scoop || pitch.techniques.fall || pitch.techniques.hammer || pitch.techniques.pull ||
+                pitch.techniques.overshoot || pitch.techniques.rise);
+
+        public static bool IsEnabled(UPitch pitch, string name) {
+            if (!Matches(pitch)) { return false; }
+            return name switch {
+                "scoop" => pitch.techniques!.scoop,
+                "fall" => pitch.techniques!.fall,
+                "hammer" => pitch.techniques!.hammer,
+                "pull" => pitch.techniques!.pull,
+                "overshoot" => pitch.techniques!.overshoot,
+                "rise" => pitch.techniques!.rise,
+                _ => false,
+            };
+        }
+
+        public static float Parameter(UPitch pitch, string key) {
+            var s = pitch.techniques ?? new VocalTechniqueState();
+            return key switch {
+                "ScoopDepth" => s.scoopDepth, "ScoopLength" => s.scoopLength, "ScoopCurve" => s.scoopCurve,
+                "FallDepth" => s.fallDepth, "FallLength" => s.fallLength, "FallCurve" => s.fallCurve,
+                "HammerDepth" => s.hammerDepth, "HammerLength" => s.hammerLength, "HammerRise" => s.hammerRise,
+                "PullDepth" => s.pullDepth, "PullLength" => s.pullLength, "PullDrop" => s.pullDrop,
+                "OvershootDepth" => s.overshootDepth, "OvershootLength" => s.overshootLength, "OvershootCurve" => s.overshootCurve,
+                "RiseDepth" => s.riseDepth, "RiseLength" => s.riseLength, "RiseCurve" => s.riseCurve,
+                _ => throw new ArgumentException("Unknown parameter", nameof(key)),
+            };
+        }
+
+        public static UPitch Adjust(UPitch pitch, double durationMs, string key, float value) {
+            string name = key.StartsWith("Scoop") ? "scoop" : key.StartsWith("Fall") ? "fall" :
+                key.StartsWith("Hammer") ? "hammer" : key.StartsWith("Pull") ? "pull" : key.StartsWith("Overshoot") ? "overshoot" :
+                key.StartsWith("Rise") ? "rise" : throw new ArgumentException("Unknown parameter", nameof(key));
+            if (!IsEnabled(pitch, name) || !float.IsFinite(value)) { return pitch.Clone(); }
+            var copy = pitch.Clone();
+            var s = copy.techniques!;
+            float depth = Math.Clamp(value, 0, 1200);
+            float length = Math.Clamp(value, 1, 2000);
+            float curve = Math.Clamp((float)Math.Round(value), 0, 3);
+            switch (key) {
+                case "ScoopDepth": s.scoopDepth = depth; break;
+                case "ScoopLength": s.scoopLength = length; break;
+                case "ScoopCurve": s.scoopCurve = curve; break;
+                case "FallDepth": s.fallDepth = depth; break;
+                case "FallLength": s.fallLength = length; break;
+                case "FallCurve": s.fallCurve = curve; break;
+                case "HammerDepth": s.hammerDepth = depth; break;
+                case "HammerLength": s.hammerLength = length; break;
+                case "HammerRise": s.hammerRise = Math.Clamp(value, 1, 500); break;
+                case "PullDepth": s.pullDepth = depth; break;
+                case "PullLength": s.pullLength = length; break;
+                case "PullDrop": s.pullDrop = Math.Clamp(value, 1, 500); break;
+                case "OvershootDepth": s.overshootDepth = depth; break;
+                case "OvershootLength": s.overshootLength = length; break;
+                case "OvershootCurve": s.overshootCurve = curve; break;
+                case "RiseDepth": s.riseDepth = depth; break;
+                case "RiseLength": s.riseLength = length; break;
+                case "RiseCurve": s.riseCurve = curve; break;
+                default: throw new ArgumentException("Unknown parameter", nameof(key));
+            }
+            return Set(copy, durationMs, name, true);
+        }
+
+        public static UPitch Set(UPitch pitch, double durationMs, string name, bool enabled) {
+            if (name != "scoop" && name != "fall" && name != "hammer" && name != "pull" && name != "overshoot" && name != "rise") {
+                throw new ArgumentException("Unknown vocal technique", nameof(name));
+            }
+            var state = Matches(pitch) ? pitch.techniques!.Clone() : new VocalTechniqueState {
+                original = pitch.data.Select(p => p.Clone()).ToList(),
+                originalSnapFirst = pitch.snapFirst,
+            };
+            if (pitch.snapFirst && pitch.data.Count > 0 && state.original.Count > 0) {
+                state.original[0].Y = pitch.data[0].Y;
+            }
+            switch (name) {
+                case "scoop": state.scoop = enabled; if (enabled) { state.pull = false; } break;
+                case "fall": state.fall = enabled; if (enabled) { state.rise = false; } break;
+                case "hammer": state.hammer = enabled; if (enabled) { state.pull = false; } break;
+                case "pull": state.pull = enabled; if (enabled) { state.scoop = state.hammer = false; } break;
+                case "overshoot": state.overshoot = enabled; break;
+                case "rise": state.rise = enabled; if (enabled) { state.fall = false; } break;
+            }
+            if (!state.scoop && !state.fall && !state.hammer && !state.pull && !state.overshoot && !state.rise) {
+                state.applied = state.original.Select(p => p.Clone()).ToList();
+                return new UPitch { data = state.original.Select(p => p.Clone()).ToList(),
+                    snapFirst = state.originalSnapFirst, techniques = state };
+            }
+            float duration = (float)Math.Max(1, double.IsFinite(durationMs) ? durationMs : 1);
+            var points = state.original.Select(p => p.Clone()).ToList();
+            if (points.Count < 2) {
+                points = new() { new(-40, 0), new(40, 0) };
+            }
+            PitchPointShape Shape(float value) => (int)value switch {
+                1 => PitchPointShape.l, 2 => PitchPointShape.i, 3 => PitchPointShape.o,
+                _ => PitchPointShape.io,
+            };
+            // Edit the native entry transition, preserving later hand-authored points.
+            bool hasEntry = state.scoop || state.hammer || state.pull;
+            bool stepped = state.hammer || state.pull;
+            if (hasEntry) {
+                float start = Math.Min(0, points[0].X);
+                float end = Math.Min(duration * (state.overshoot ? .3f : .5f), start + Math.Max(1,
+                    state.pull ? state.pullLength + state.pullDrop :
+                    state.hammer ? state.hammerLength + state.hammerRise : state.scoopLength));
+                end = Math.Max(start + .1f, end);
+                float target = points[1].Y;
+                float depth = state.pull ? -state.pullDepth :
+                    (state.scoop ? state.scoopDepth : 0) + (state.hammer ? state.hammerDepth : 0);
+                var entry = new List<PitchPoint>();
+                entry.Add(new(start, points[0].Y, Shape(state.scoopCurve)));
+                float dip = start + (end - start) * .4f;
+                if (stepped) { dip = Math.Min(start + (end - start) * .2f, 0); }
+                dip = Math.Max(start + .001f, dip);
+                entry.Add(new(dip, target - depth / 10, stepped ? PitchPointShape.l : Shape(state.scoopCurve)));
+                if (stepped) {
+                    float transition = state.pull ? state.pullDrop : state.hammerRise;
+                    float step = Math.Max(start + .01f, end - Math.Min(transition, (end - start) * .5f));
+                    entry.Add(new(step, target + (state.pull ? state.pullDepth : -state.hammerDepth) / 10, PitchPointShape.l));
+                }
+                entry.Add(new(end, target, points[1].shape));
+                points = entry.Concat(points.Skip(2).Where(p => p.X > end)).ToList();
+            }
+            float entryEnd = hasEntry ? points[stepped ? 3 : 2].X : 0;
+            float At(List<PitchPoint> data, float x) {
+                for (int i = 1; i < data.Count; i++) {
+                    if (x <= data[i].X) {
+                        return (float)MusicMath.InterpolateShape(data[i - 1].X, data[i].X,
+                            data[i - 1].Y, data[i].Y, Math.Max(data[i - 1].X, x), data[i - 1].shape);
+                    }
+                }
+                return data[^1].Y;
+            }
+            if (state.overshoot && points[0].X < duration * .5f - .001f) {
+                float start = hasEntry ? entryEnd : Math.Max(0, Math.Min(points[1].X, duration * .3f));
+                start = Math.Max(points[0].X, start);
+                float end = Math.Min(duration * .5f, start + state.overshootLength);
+                float peak = start + (end - start) * .4f;
+                float baseline = At(points, start);
+                float target = hasEntry ? baseline : points[1].Y;
+                var before = points.Where(p => p.X < start).ToList();
+                // Keep the snapped connection point even when the hump begins at zero.
+                if (before.Count == 0) { before.Add(points[0].Clone()); start = points[0].X; }
+                if (before[^1].X < start) { before.Add(new(start, baseline, Shape(state.overshootCurve))); }
+                else { before[^1].shape = Shape(state.overshootCurve); }
+                before.Add(new(peak, target + state.overshootDepth / 10, Shape(state.overshootCurve)));
+                before.Add(new(end, target, points.LastOrDefault(p => p.X <= end)?.shape ?? PitchPointShape.io));
+                points = before.Concat(points.Where(p => p.X > end)).ToList();
+                entryEnd = end;
+            }
+            if (state.fall || state.rise) {
+                float length = state.rise ? state.riseLength : state.fallLength;
+                // Leave a stable pitched region between entry expression and the release.
+                float start = Math.Max(entryEnd + duration * .2f, duration - Math.Min(length, duration * .3f));
+                start = Math.Min(start, duration - .01f);
+                float baseline = At(points, start);
+                points = points.Where(p => p.X < start).ToList();
+                points.Add(new(start, baseline, Shape(state.rise ? state.riseCurve : state.fallCurve)));
+                points.Add(new(duration, baseline + (state.rise ? state.riseDepth : -state.fallDepth) / 10, PitchPointShape.l));
+            }
+            var result = new UPitch { snapFirst = state.originalSnapFirst, data = points, techniques = state };
+            state.applied = result.data.Select(p => p.Clone()).ToList();
+            return result;
+        }
+    }
+}
