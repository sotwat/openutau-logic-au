+        public void AllCombinationsKeepFewOrderedPointsAndStableMiddle(double duration) {
+            string[] names = { "scoop", "fall", "hammer", "overshoot", "rise", "pull" };
+            for (int mask = 0; mask < 64; mask++) {
+                var original = new UPitch { snapFirst = true, data = new() { new(-40, -20), new(40, 0) } };
+                var pitch = original.Clone();
+                for (int i = 0; i < names.Length; i++) {
+                    if ((mask & (1 << i)) != 0) { pitch = VocalTechniques.Set(pitch, duration, names[i], true); }
+                }
+                Assert.All(pitch.data, p => Assert.True(float.IsFinite(p.X) && float.IsFinite(p.Y)));
+                Assert.True(pitch.data.Zip(pitch.data.Skip(1)).All(p => p.First.X < p.Second.X));
+                Assert.True(pitch.data.Count <= 8);
+                Assert.Equal(-20, pitch.data[0].Y);
+                Assert.True(pitch.snapFirst);
+                if (VocalTechniques.IsEnabled(pitch, "scoop") || VocalTechniques.IsEnabled(pitch, "hammer") || VocalTechniques.IsEnabled(pitch, "pull") || VocalTechniques.IsEnabled(pitch, "overshoot")) {
