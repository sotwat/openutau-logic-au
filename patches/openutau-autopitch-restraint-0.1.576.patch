+        public const double DeviationStrength = 0.25;
+        public const int DeviationLimitCents = 25;
+
+        public static CurveResult RestrainDeviation(CurveResult generated, IReadOnlyList<UNote> notes) {
+            if (generated.Xs.Length == 0 || generated.Xs.Length != generated.Ys.Length ||
+                generated.Xs.Zip(generated.Xs.Skip(1)).Any(p => p.First >= p.Second)) {
+                throw new InvalidDataException("Invalid Auto Pitch result.");
+            }
+            var predicted = new UCurve(new UExpressionDescriptor("pitch deviation", Format.Ustx.PITD, -1200, 1200, 0)) {
+                xs = generated.Xs.ToList(), ys = generated.Ys.ToList(),
+            };
+            var output = new SortedDictionary<int, int>();
+            foreach (var note in notes.OrderBy(n => n.position)) {
+                if (note.duration <= 0) { continue; }
+                // A sustained bias is perceived as detuning; keep only the motion around the note's core.
+                var core = Enumerable.Range(0, 17).Select(i => predicted.Sample(
+                    note.position + (int)Math.Round(note.duration * (0.25 + i / 32.0)))).OrderBy(v => v).ToArray();
+                double center = core[core.Length / 2];
+                for (int offset = 0; offset < note.duration; offset += UCurve.interval) {
+                    double phase = (double)offset / note.duration;
+                    double edge = Math.Clamp(Math.Min(phase, 1 - phase) / 0.12, 0, 1);
+                    double fade = edge * edge * (3 - 2 * edge);
+                    double delta = (predicted.Sample(note.position + offset) - center) * DeviationStrength;
+                    double limited = DeviationLimitCents * Math.Tanh(delta / DeviationLimitCents);
+                    output[note.position + offset] = (int)Math.Round(limited * fade);
+                }
+                output[note.End] = 0;
+            }
+            return new CurveResult(output.Keys.ToArray(), output.Values.ToArray());
         }
 
