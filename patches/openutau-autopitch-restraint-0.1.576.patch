         [Fact]
+        public void RestraintRemovesDetuningWithoutFlatteningAllExpression() {
+            var (_, part) = Fixture();
+            var note = part.notes.First();
+            var xs = Enumerable.Range(0, 49).Select(i => i * 5).ToArray();
+            var ys = xs.Select(x => 400 + (int)Math.Round(180 * Math.Sin(x * Math.PI / 120))).ToArray();
+            var before = Notes(part);
+            var restrained = UtauVAutoPitch.RestrainDeviation(new(xs, ys), new[] { note });
+            var shifted = UtauVAutoPitch.RestrainDeviation(new(xs, ys.Select(y => y - 700).ToArray()), new[] { note });
+            Assert.Equal(restrained.Ys, shifted.Ys);
+            Assert.All(restrained.Ys, y => Assert.InRange(y, -25, 25));
+            Assert.Contains(restrained.Ys, y => y > 5);
+            Assert.Contains(restrained.Ys, y => y < -5);
+            Assert.Equal(0, restrained.Ys[0]);
+            Assert.Equal(0, restrained.Ys[^1]);
+            Assert.Equal(before, Notes(part));
+        }
+
+        [Fact]
