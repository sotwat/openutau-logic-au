diff --git a/OpenUtau.Test/Core/DiffSinger/DiffSingerCacheSafetyTest.cs b/OpenUtau.Test/Core/DiffSinger/DiffSingerCacheSafetyTest.cs
new file mode 100644
--- /dev/null
+++ b/OpenUtau.Test/Core/DiffSinger/DiffSingerCacheSafetyTest.cs
@@ -0,0 +1,78 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Collections.Generic;
+using System.Threading;
+using Microsoft.ML.OnnxRuntime;
+using Microsoft.ML.OnnxRuntime.Tensors;
+using OpenUtau.Core.DiffSinger;
+using OpenUtau.Core;
+using Xunit;
+
+namespace OpenUtau.Core {
+    [Collection(RenderSingletonCollection.Name)]
+    public class DiffSingerCacheSafetyTest {
+        static List<NamedOnnxValue> Values(params float[] data) => new() {
+            NamedOnnxValue.CreateFromTensor("waveform", new DenseTensor<float>(data, new[] { 1, data.Length })),
+        };
+        static DiffSingerCache Cache() => new((ulong)DateTime.UtcNow.Ticks, Values(Guid.NewGuid().GetHashCode()));
+        static string PathOf(DiffSingerCache cache) => Path.Combine(PathManager.Inst.CachePath, cache.Filename);
+
+        [Fact]
+        public void NonFiniteSaveCannotReplaceHealthyCache() {
+            var cache = Cache();
+            try {
+                cache.Save(Values(0.1f, -0.2f));
+                var original = File.ReadAllBytes(PathOf(cache));
+                Assert.Throws<InvalidDataException>(() => cache.Save(Values(float.NaN)));
+                Assert.Throws<InvalidDataException>(() => cache.Save(Values(float.PositiveInfinity)));
+                Assert.Equal(original, File.ReadAllBytes(PathOf(cache)));
+                Assert.Equal(new[] { 0.1f, -0.2f }, cache.Load()!.Single().AsTensor<float>().ToArray());
+                Assert.Empty(Directory.GetFiles(PathManager.Inst.CachePath, cache.Filename + ".*.tmp"));
+            } finally { cache.Delete(); }
+        }
+
+        [Fact]
+        public void NonFiniteTruncatedAndBadHeaderCachesAreRegenerated() {
+            var cache = Cache();
+            try {
+                cache.Save(Values(0.1f, 0.2f));
+                using (var file = File.OpenWrite(PathOf(cache))) {
+                    file.Position = file.Length - 4;
+                    using var writer = new BinaryWriter(file);
+                    writer.Write(float.NaN);
+                }
+                Assert.Null(cache.Load());
+                Assert.False(File.Exists(PathOf(cache)));
+                cache.Save(Values(0.1f, 0.2f));
+                using (var file = File.OpenWrite(PathOf(cache))) { file.SetLength(file.Length - 2); }
+                Assert.Null(cache.Load());
+                File.WriteAllText(PathOf(cache), "broken");
+                Assert.Null(cache.Load());
+            } finally { cache.Delete(); }
+        }
+
+        [Fact]
+        public void InvalidOrSilentInferenceRetriesWithoutReturningSilence() {
+            foreach (var invalid in new[] { new[] { float.NaN }, new[] { 0f, 0f }, Array.Empty<float>() }) {
+                int calls = 0;
+                var recovered = DiffSingerRenderer.RenderWithRecovery(
+                    () => ++calls == 1 ? invalid : new[] { 0.1f, -0.2f }, CancellationToken.None);
+                Assert.Equal(2, calls);
+                Assert.Equal(new[] { 0.1f, -0.2f }, recovered);
+            }
+        }
+
+        [Fact]
+        public void RepeatedFailureIsExplicitAndCancellationRunsNoInference() {
+            int calls = 0;
+            Assert.Throws<InvalidDataException>(() => DiffSingerRenderer.RenderWithRecovery(
+                () => { calls++; return new[] { float.NaN }; }, CancellationToken.None));
+            Assert.Equal(2, calls);
+            Assert.Throws<OperationCanceledException>(() => DiffSingerRenderer.RenderWithRecovery(
+                () => throw new Exception("Must not run"), new CancellationToken(true)));
+            Assert.True(DiffSingerRenderer.IsUsableAudio(new[] { 0f }, requireSignal: false));
+            Assert.False(DiffSingerRenderer.IsUsableAudio(new[] { float.NaN }, requireSignal: false));
+        }
+    }
+}
