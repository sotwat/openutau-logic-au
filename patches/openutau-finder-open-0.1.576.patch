+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading.Tasks;
+using Xunit;
+
+namespace OpenUtau.App {
+    public class ExternalProjectFilesTest {
+        [Fact]
+        public void SelectsOnlyRequestedProjectsAndDecodesFileUris() {
+            var folder = Path.Combine(Path.GetTempPath(), "日本語 空白");
+            var project = Path.Combine(folder, "譜面.USTX");
+            Assert.Equal(new[] { project, Path.Combine(folder, "song.midi") },
+                ExternalProjectFiles.SelectPaths(new[] { new Uri(project).AbsoluteUri, project,
+                    Path.Combine(folder, "song.midi"), "audio.wav", "audio.mp3", "https://example.invalid/a.ust", "-psn_123" }));
+        }
+
+        [Fact]
+        public async Task WaitsForStartupAndSerializesRequestsWhileDialogIsOpen() {
+            var queue = new ExternalProjectFiles();
+            var seen = new List<string>();
+            var gate = new TaskCompletionSource();
+            await queue.Enqueue(new[] { "/tmp/first.ustx" });
+            Assert.Empty(seen);
+            var ready = queue.Ready(async files => {
+                seen.AddRange(files);
+                if (seen.Count == 1) { await gate.Task; }
+            });
+            await queue.Enqueue(new[] { "/tmp/second.mid" });
+            Assert.Single(seen);
+            gate.SetResult();
+            await ready;
+            Assert.Equal(new[] { "/tmp/first.ustx", "/tmp/second.mid" }, seen);
+            await queue.Enqueue(new[] { "/tmp/third.midi" });
+            Assert.Equal("/tmp/third.midi", seen.Last());
+        }
+
+        [Fact]
+        public async Task GroupsUstTracksButDoesNotSilentlyDropMixedProjects() {
+            var queue = new ExternalProjectFiles();
+            var seen = new List<string[]>();
+            await queue.Ready(files => { seen.Add(files); return Task.CompletedTask; });
+            await queue.Enqueue(new[] { "/tmp/a.ust", "/tmp/b.UST" });
+            await queue.Enqueue(new[] { "/tmp/a.ustx", "/tmp/b.mid" });
+            Assert.Equal(new[] { 2, 1, 1 }, seen.Select(files => files.Length));
+        }
+    }
+}
