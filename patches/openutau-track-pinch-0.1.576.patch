diff --git a/OpenUtau.Test/App/TrackPinchTest.cs b/OpenUtau.Test/App/TrackPinchTest.cs
--- /dev/null
+++ b/OpenUtau.Test/App/TrackPinchTest.cs
@@ -0,0 +1,46 @@
+using System;
+using Avalonia;
+using OpenUtau.App.ViewModels;
+using OpenUtau.Core;
+using OpenUtau.Core.Ustx;
+using ReactiveUI.Builder;
+using Xunit;
+
+namespace OpenUtau.App {
+    [Collection(RenderSingletonCollection.Name)]
+    public class TrackPinchTest {
+        [Fact]
+        public void PinchKeepsPointerTimeAndTrackDimensions() {
+            RxAppBuilder.CreateReactiveUIBuilder().WithCoreServices().BuildApp();
+            var previous = DocManager.Inst.TakeProjectForTest(new UProject());
+            try {
+                var vm = new TracksViewModel { Bounds = new Rect(0, 0, 1000, 500), TickWidth = 0.1, TickOffset = 5000 };
+                double anchor = vm.TickOffset + 0.4 * vm.ViewportTicks;
+                double height = vm.TrackHeight;
+                double vertical = vm.TrackOffset;
+                vm.OnTrackpadMagnify(new Point(0.4, 0), 0.2, 1);
+                Assert.True(vm.TickWidth > 0.1);
+                Assert.Equal(anchor, vm.TickOffset + 0.4 * vm.ViewportTicks, 6);
+                vm.OnTrackpadMagnify(new Point(0.4, 0), -0.1, 1);
+                Assert.True(vm.TickWidth < 0.12);
+                Assert.Equal(anchor, vm.TickOffset + 0.4 * vm.ViewportTicks, 6);
+                Assert.Equal(height, vm.TrackHeight);
+                Assert.Equal(vertical, vm.TrackOffset);
+                double width = vm.TickWidth;
+                foreach (double delta in new[] { 0, double.NaN, double.PositiveInfinity }) {
+                    vm.OnTrackpadMagnify(new Point(0.4, 0), delta, 1);
+                    Assert.Equal(width, vm.TickWidth);
+                }
+                vm.OnTrackpadMagnify(new Point(0.4, 0), 0.4, 2);
+                Assert.Equal(width, vm.TickWidth);
+                vm.OnTrackpadMagnify(new Point(0.4, 0), 0.1, 0);
+                Assert.True(vm.TickWidth > width);
+                vm.OnTrackpadMagnify(new Point(0.4, 0), -10, 1);
+                Assert.True(double.IsFinite(vm.TickWidth) && vm.TickWidth > 0);
+                Assert.InRange(vm.TickOffset, 0, vm.HScrollBarMax);
+            } finally {
+                DocManager.Inst.TakeProjectForTest(previous);
+            }
+        }
+    }
+}
