+using System;
+using System.Linq;
+using OpenUtau.Core.Render;
+using OpenUtau.Core.Ustx;
+using OpenUtau.Core.Util;
+using Xunit;
+
+namespace OpenUtau.Core.Pipeline {
+    public class NoteGainTest {
+        [Fact]
+        public void SaveCloneLegacyAndMultipleNoteUndo() {
+            var a = UNote.Create();
+            var b = UNote.Create();
+            a.noteGain = 35;
+            b.noteGain = 160;
+            var command = new NoteGainCommand(new UVoicePart(), new[] { a, b }, 75);
+            command.Execute();
+            Assert.Equal(75, a.noteGain);
+            Assert.Equal(75, b.noteGain);
+            command.Unexecute();
+            Assert.Equal(35, a.noteGain);
+            Assert.Equal(160, b.noteGain);
+            command.Execute();
+            Assert.Equal(75, a.Clone().noteGain);
+            var saved = Yaml.DefaultSerializer.Serialize(a);
+            Assert.Equal(75, Yaml.DefaultDeserializer.Deserialize<UNote>(saved).noteGain);
+            Assert.Equal(100, Yaml.DefaultDeserializer.Deserialize<UNote>("position: 0\nduration: 480\ntone: 60\nlyric: a\n").noteGain);
+        }
+
+        [Theory]
+        [InlineData(0)] [InlineData(50)] [InlineData(100)] [InlineData(200)]
+        public void RealPhrasesApplyGainAlongsideDynamics(int percent) {
+            var (project, track, part) = PhraseSourceHashTest.BuildFixture();
+            var baseline = RenderPhrase.FromPart(project, track, part)[0];
+            var note = part.notes.First();
+            note.noteGain = percent;
+            var changed = RenderPhrase.FromPart(project, track, part)[0];
+            var a = new RenderResult { positionMs = baseline.positionMs, leadingMs = baseline.leadingMs,
+                samples = Enumerable.Repeat(1f, 100000).ToArray() };
+            var b = new RenderResult { positionMs = changed.positionMs, leadingMs = changed.leadingMs,
+                samples = Enumerable.Repeat(1f, 100000).ToArray() };
+            Renderers.ApplyDynamics(baseline, a);
+            Renderers.ApplyDynamics(changed, b);
+            int sample = (int)((note.PositionMs + 100 - a.positionMs + a.leadingMs) * 44.1);
+            Assert.Equal(a.samples[sample] * percent / 100f, b.samples[sample], 5);
+            int next = (int)((part.notes.Skip(1).First().PositionMs + 100 - a.positionMs + a.leadingMs) * 44.1);
+            Assert.Equal(a.samples[next], b.samples[next], 5);
+            if (percent == 100) {
+                Assert.Equal(baseline.hash, changed.hash);
+                Assert.Equal(a.samples, b.samples);
+            } else {
+                Assert.NotEqual(baseline.hash, changed.hash);
+                Assert.Equal(baseline.preEffectHash, changed.preEffectHash);
+            }
+        }
+
+        [Fact]
+        public void BoundaryIsSmoothedAndExtensionHasIndependentGain() {
+            var (project, track, part) = PhraseSourceHashTest.BuildFixture();
+            part.curves.Clear();
+            var extended = part.notes.Last();
+            extended.noteGain = 0;
+            var phrase = RenderPhrase.FromPart(project, track, part).Last();
+            var result = new RenderResult { positionMs = phrase.positionMs, leadingMs = phrase.leadingMs,
+                samples = Enumerable.Repeat(1f, 100000).ToArray() };
+            Renderers.ApplyNoteGain(phrase.notes, result);
+            int boundary = (int)Math.Ceiling((extended.PositionMs - result.positionMs + result.leadingMs) * 44.1);
+            Assert.Equal(1f, result.samples[boundary - 1]);
+            Assert.InRange(result.samples[boundary], 0.99f, 1f);
+            Assert.InRange(result.samples[boundary + 110], 0.48f, 0.51f);
+            Assert.Equal(0f, result.samples[boundary + 220]);
+            Assert.All(result.samples, f => Assert.True(float.IsFinite(f)));
+        }
+
+        [Fact]
+        public void SnapshotFreezesGainAndClampsMalformedValue() {
+            var (project, track, part) = PhraseSourceHashTest.BuildFixture();
+            var note = part.notes.First();
+            note.noteGain = 500;
+            var snapshot = PhraseSource.FromPart(project, track, part, 1);
+            note.noteGain = 10;
+            Assert.Equal(200, snapshot.Notes[0].NoteGain);
+        }
+    }
+}
