+        public static void ApplyNoteGain(RenderNote[] notes, RenderResult result) {
+            if (result.samples == null || notes.Length == 0 || notes.All(n => n.noteGain == 1f)) {
+                return;
+            }
+            var changes = new List<(double ms, float gain)>();
+            for (int i = 1; i < notes.Length; i++) {
+                if (notes[i].positionMs > notes[i - 1].endMs) {
+                    changes.Add((notes[i - 1].endMs, 1f));
+                }
+                changes.Add((notes[i].positionMs, notes[i].noteGain));
+            }
+            // Keep the first consonant and final release at their note's gain.
+            double startMs = result.positionMs - result.leadingMs;
+            float gain = notes[0].noteGain;
+            float target = gain;
+            int remaining = 0;
+            int next = 0;
+            for (int sample = 0; sample < result.samples.Length; sample++) {
+                double ms = startMs + sample / 44.1;
+                while (next < changes.Count && changes[next].ms <= ms) {
+                    target = changes[next++].gain;
+                    remaining = 220;
+                    if (ms - changes[next - 1].ms >= 5) {
+                        gain = target;
+                        remaining = 0;
+                    }
+                }
+                if (remaining > 0) {
+                    gain += (target - gain) / remaining--;
+                }
+                result.samples[sample] *= gain;
+            }
+        }
