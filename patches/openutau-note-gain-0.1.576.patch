@@ -0,0 +1,28 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using OpenUtau.Core.Ustx;
+
+namespace OpenUtau.Core {
+    public class NoteGainCommand : NoteCommand {
+        readonly int[] oldValues;
+        readonly int value;
+
+        public NoteGainCommand(UVoicePart part, IEnumerable<UNote> notes, int value) : base(part, notes) {
+            oldValues = Notes.Select(n => n.noteGain).ToArray();
+            this.value = Math.Clamp(value, 0, 200);
+        }
+
+        public override string ToString() => "Set note volume";
+        public override void Execute() {
+            lock (Part) {
+                foreach (var note in Notes) { note.noteGain = value; }
+            }
+        }
+        public override void Unexecute() {
+            lock (Part) {
+                for (int i = 0; i < Notes.Length; i++) { Notes[i].noteGain = oldValues[i]; }
+            }
+        }
+    }
+}
