diff --git a/OpenUtau.Core/Coeiroink/CoeiroinkConfig.cs b/OpenUtau.Core/Coeiroink/CoeiroinkConfig.cs
new file mode 100644
--- /dev/null
+++ b/OpenUtau.Core/Coeiroink/CoeiroinkConfig.cs
@@ -0,0 +1,115 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+namespace OpenUtau.Core.Coeiroink {
+    public class CoeiroinkStyle {
+        public string Name = string.Empty;
+        public int Id;
+        public string ModelDir = string.Empty;
+        public string Icon = string.Empty;
+
+        public string DurationModelPath => Path.Combine(ModelDir, CoeiroinkConfig.DurationModelFile);
+        public string SynthModelPath => Path.Combine(ModelDir, CoeiroinkConfig.SynthModelFile);
+        public string ConfigPath => Path.Combine(ModelDir, "config.yaml");
+        public bool IsExported => File.Exists(DurationModelPath) && File.Exists(SynthModelPath);
+    }
+
+    public class CoeiroinkConfig {
+        public const string ExporterUrl = "https://github.com/emeraldsingers/coeiroink-onnx-exporter";
+        public const string MetasFile = "metas.json";
+        public const string DurationModelFile = "duration.onnx";
+        public const string SynthModelFile = "synth.onnx";
+
+        public string SpeakerName = string.Empty;
+        public string SpeakerUuid = string.Empty;
+        public string Version = string.Empty;
+        public List<CoeiroinkStyle> Styles = new List<CoeiroinkStyle>();
+
+        public static bool IsCoeiroinkFolder(string dir) {
+            return File.Exists(Path.Combine(dir, MetasFile)) && Directory.Exists(Path.Combine(dir, "model"));
+        }
+
+        public static CoeiroinkConfig Load(string dir) {
+            var config = new CoeiroinkConfig();
+            using var doc = JsonDocument.Parse(File.ReadAllText(Path.Combine(dir, MetasFile)));
+            var root = doc.RootElement;
+            config.SpeakerName = root.TryGetProperty("speakerName", out var name) ? name.GetString() ?? string.Empty : string.Empty;
+            config.SpeakerUuid = root.TryGetProperty("speakerUuid", out var uuid) ? uuid.GetString() ?? string.Empty : string.Empty;
+            config.Version = root.TryGetProperty("version", out var version) ? version.GetString() ?? string.Empty : string.Empty;
+            if (root.TryGetProperty("styles", out var styles)) {
+                foreach (var style in styles.EnumerateArray()) {
+                    int id = style.GetProperty("styleId").GetInt32();
+                    config.Styles.Add(new CoeiroinkStyle {
+                        Name = style.GetProperty("styleName").GetString() ?? id.ToString(),
+                        Id = id,
+                        ModelDir = Path.Combine(dir, "model", id.ToString()),
+                        Icon = Path.Combine(dir, "icons", $"{id}.png"),
+                    });
+                }
+            }
+            return config;
+        }
+    }
+
+    public class CoeiroinkModelConfig {
+        public string[] Tokens = Array.Empty<string>();
+        public int SampleRate = 44100;
+        public int HopLength = 512;
+        public int HiddenChannels = 192;
+
+        public static CoeiroinkModelConfig Load(string path) {
+            var lines = File.ReadAllLines(path);
+            var config = new CoeiroinkModelConfig();
+            var tokens = new List<string>();
+            bool inTokens = false;
+            foreach (var line in lines) {
+                if (inTokens) {
+                    var match = Regex.Match(line, @"^-\s*(.+?)\s*$");
+                    if (match.Success) {
+                        tokens.Add(Unquote(match.Groups[1].Value));
+                        continue;
+                    }
+                    inTokens = false;
+                }
+                if (line.StartsWith("token_list:")) {
+                    inTokens = true;
+                    continue;
+                }
+                config.SampleRate = ReadInt(line, @"^\s+sampling_rate:\s*(\d+)", config.SampleRate);
+                config.HopLength = ReadInt(line, @"^\s+hop_length:\s*(\d+)", config.HopLength);
+                config.HiddenChannels = ReadInt(line, @"^\s+hidden_channels:\s*(\d+)", config.HiddenChannels);
+            }
+            config.Tokens = tokens.ToArray();
+            if (config.Tokens.Length == 0) {
+                throw new InvalidDataException($"token_list was not found in {path}");
+            }
+            return config;
+        }
+
+        static int ReadInt(string line, string pattern, int fallback) {
+            var match = Regex.Match(line, pattern);
+            return match.Success ? int.Parse(match.Groups[1].Value) : fallback;
+        }
+
+        static string Unquote(string value) {
+            if (value.Length >= 2 && (value[0] == '\'' && value[^1] == '\'' || value[0] == '"' && value[^1] == '"')) {
+                return value.Substring(1, value.Length - 2).Replace("''", "'");
+            }
+            return value;
+        }
+
+        public double FrameMs => HopLength * 1000.0 / SampleRate;
+
+        public Dictionary<string, long> TokenIds() {
+            var map = new Dictionary<string, long>();
+            for (int i = 0; i < Tokens.Length; i++) {
+                map.TryAdd(Tokens[i], i);
+            }
+            return map;
+        }
+    }
+}
diff --git a/OpenUtau.Core/Coeiroink/CoeiroinkKana.cs b/OpenUtau.Core/Coeiroink/CoeiroinkKana.cs
new file mode 100644
--- /dev/null
+++ b/OpenUtau.Core/Coeiroink/CoeiroinkKana.cs
@@ -0,0 +1,249 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text;
+using System.Text.RegularExpressions;
+
+namespace OpenUtau.Core.Coeiroink {
+    public readonly struct CoeiroinkMora {
+        public readonly string? Consonant;
+        public readonly string Vowel;
+
+        public CoeiroinkMora(string? consonant, string vowel) {
+            Consonant = string.IsNullOrEmpty(consonant) ? null : consonant;
+            Vowel = vowel;
+        }
+
+        public bool IsGeminate => Vowel == CoeiroinkKana.Geminate;
+
+        public override string ToString() => Consonant == null ? Vowel : $"{Consonant} {Vowel}";
+    }
+
+    public static class CoeiroinkKana {
+        public const string Geminate = "cl";
+        public const string Nasal = "N";
+
+        static readonly string[] vowelTokens = { "a", "i", "u", "e", "o" };
+        static readonly HashSet<string> consonantTokens = new HashSet<string> {
+            "k", "s", "sh", "t", "ch", "ts", "n", "h", "f", "m", "y", "r", "w", "g", "z", "j", "d", "b", "p", "v",
+            "ky", "gy", "ny", "hy", "my", "by", "py", "ry", "dy", "ty",
+        };
+
+        static readonly Dictionary<string, (string? c, string v)> table = BuildTable();
+        static readonly Regex romaji = new Regex("^(ky|gy|ny|hy|my|by|py|ry|dy|ty|sh|ch|ts|[kstnhfmyrwgzjdbpv])?([aiueo])$", RegexOptions.Compiled);
+
+        public static bool IsConsonantToken(string text) {
+            return consonantTokens.Contains(text.Trim());
+        }
+
+        public static double DefaultConsonantMs(string consonant) {
+            switch (consonant) {
+                case "k": case "t": case "p": case "g": case "d": case "b":
+                    return 50;
+                case "ch": case "ts":
+                    return 100;
+                case "s": case "sh": case "h": case "f": case "z": case "j": case "hy": case "v":
+                    return 90;
+                case "y": case "w":
+                    return 50;
+                default:
+                    return 65;
+            }
+        }
+
+        public static IEnumerable<string> AllKana => table.Keys.Concat(new[] { "ん", "っ" });
+
+        static Dictionary<string, (string? c, string v)> BuildTable() {
+            var map = new Dictionary<string, (string? c, string v)>();
+            void Row(string? consonant, string kana) {
+                for (int i = 0; i < 5; i++) {
+                    if (i < kana.Length && kana[i] != '-') {
+                        map[kana[i].ToString()] = (consonant, vowelTokens[i]);
+                    }
+                }
+            }
+            Row(null, "あいうえお");
+            Row("k", "かきくけこ");
+            Row("s", "さしすせそ");
+            Row("t", "たちつてと");
+            Row("n", "なにぬねの");
+            Row("h", "はひふへほ");
+            Row("m", "まみむめも");
+            Row("y", "や-ゆ-よ");
+            Row("r", "らりるれろ");
+            Row("w", "わ---を");
+            Row("g", "がぎぐげご");
+            Row("z", "ざじずぜぞ");
+            Row("d", "だぢづでど");
+            Row("b", "ばびぶべぼ");
+            Row("p", "ぱぴぷぺぽ");
+            map["を"] = (null, "o");
+            map["し"] = ("sh", "i");
+            map["ち"] = ("ch", "i");
+            map["つ"] = ("ts", "u");
+            map["ふ"] = ("f", "u");
+            map["じ"] = ("j", "i");
+            map["ぢ"] = ("j", "i");
+            map["づ"] = ("z", "u");
+            map["ゔ"] = ("v", "u");
+            map["ゐ"] = (null, "i");
+            map["ゑ"] = (null, "e");
+
+            var smallVowels = new Dictionary<char, string> { ['ぁ'] = "a", ['ぃ'] = "i", ['ぅ'] = "u", ['ぇ'] = "e", ['ぉ'] = "o" };
+            var smallYa = new Dictionary<char, string> { ['ゃ'] = "a", ['ゅ'] = "u", ['ょ'] = "o" };
+            foreach (var (small, vowel) in smallVowels) {
+                map[small.ToString()] = (null, vowel);
+            }
+            map["ゃ"] = ("y", "a");
+            map["ゅ"] = ("y", "u");
+            map["ょ"] = ("y", "o");
+            map["ゎ"] = ("w", "a");
+
+            var palatal = new Dictionary<char, string> {
+                ['き'] = "ky", ['し'] = "sh", ['ち'] = "ch", ['に'] = "ny", ['ひ'] = "hy", ['み'] = "my",
+                ['り'] = "ry", ['ぎ'] = "gy", ['じ'] = "j", ['ぢ'] = "j", ['び'] = "by", ['ぴ'] = "py",
+                ['て'] = "ty", ['で'] = "dy", ['ゔ'] = "v",
+            };
+            foreach (var (baseKana, consonant) in palatal) {
+                foreach (var (small, vowel) in smallYa) {
+                    map[$"{baseKana}{small}"] = (consonant, vowel);
+                }
+            }
+            foreach (var (baseKana, consonant) in palatal) {
+                foreach (var (small, vowel) in smallVowels) {
+                    if (consonant == "ty" || consonant == "dy") {
+                        map[$"{baseKana}{small}"] = (consonant == "ty" ? "t" : "d", vowel);
+                    } else {
+                        map[$"{baseKana}{small}"] = (consonant, vowel);
+                    }
+                }
+            }
+            foreach (var (small, vowel) in smallVowels) {
+                map[$"ふ{small}"] = ("f", vowel);
+                map[$"つ{small}"] = ("ts", vowel);
+                map[$"う{small}"] = ("w", vowel);
+                map[$"く{small}"] = ("k", vowel);
+                map[$"ぐ{small}"] = ("g", vowel);
+            }
+            map["とぅ"] = ("t", "u");
+            map["どぅ"] = ("d", "u");
+            map["いぇ"] = ("y", "e");
+            return map;
+        }
+
+        public static string ToHiragana(string text) {
+            var sb = new StringBuilder(text.Length);
+            foreach (var c in text) {
+                if (c >= 'ァ' && c <= 'ヶ') {
+                    sb.Append((char)(c - 0x60));
+                } else {
+                    sb.Append(c);
+                }
+            }
+            return sb.ToString();
+        }
+
+        public const string PausePhoneme = "pau";
+
+        public static bool IsRest(string lyric) {
+            var text = lyric.Trim();
+            return text.Length == 0
+                || text.Equals("R", StringComparison.OrdinalIgnoreCase)
+                || text.Equals("SP", StringComparison.OrdinalIgnoreCase)
+                || text.Equals("AP", StringComparison.OrdinalIgnoreCase)
+                || text.Equals("pau", StringComparison.OrdinalIgnoreCase)
+                || text.Equals("br", StringComparison.OrdinalIgnoreCase);
+        }
+
+        public static bool IsExtension(string lyric) {
+            var text = lyric.Trim();
+            return text == "ー" || text == "-" || text.StartsWith("+");
+        }
+
+        public static bool TryParse(string lyric, out CoeiroinkMora[] moras) {
+            moras = Array.Empty<CoeiroinkMora>();
+            if (string.IsNullOrWhiteSpace(lyric)) {
+                return false;
+            }
+            var text = lyric.Normalize(NormalizationForm.FormKC).Trim();
+            if (TryParseKana(ToHiragana(text), out moras)) {
+                return true;
+            }
+            if (TryParseTokens(text.ToLowerInvariant(), out moras)) {
+                return true;
+            }
+            return false;
+        }
+
+        static bool TryParseKana(string text, out CoeiroinkMora[] moras) {
+            var result = new List<CoeiroinkMora>();
+            moras = Array.Empty<CoeiroinkMora>();
+            int i = 0;
+            while (i < text.Length) {
+                char c = text[i];
+                if (c == 'ん') {
+                    result.Add(new CoeiroinkMora(null, Nasal));
+                    i++;
+                    continue;
+                }
+                if (c == 'っ') {
+                    result.Add(new CoeiroinkMora(null, Geminate));
+                    i++;
+                    continue;
+                }
+                if (c == 'ー' && result.Count > 0 && !result[^1].IsGeminate && result[^1].Vowel != Nasal) {
+                    result.Add(new CoeiroinkMora(null, result[^1].Vowel));
+                    i++;
+                    continue;
+                }
+                if (i + 1 < text.Length && table.TryGetValue(text.Substring(i, 2), out var pair)) {
+                    result.Add(new CoeiroinkMora(pair.c, pair.v));
+                    i += 2;
+                    continue;
+                }
+                if (table.TryGetValue(c.ToString(), out var single)) {
+                    result.Add(new CoeiroinkMora(single.c, single.v));
+                    i++;
+                    continue;
+                }
+                return false;
+            }
+            moras = result.ToArray();
+            return moras.Length > 0;
+        }
+
+        static bool TryParseTokens(string text, out CoeiroinkMora[] moras) {
+            moras = Array.Empty<CoeiroinkMora>();
+            if (text == "n") {
+                moras = new[] { new CoeiroinkMora(null, Nasal) };
+                return true;
+            }
+            var match = romaji.Match(text.ToLowerInvariant());
+            if (match.Success) {
+                moras = new[] { new CoeiroinkMora(match.Groups[1].Success ? match.Groups[1].Value : null, match.Groups[2].Value) };
+                return true;
+            }
+            var result = new List<CoeiroinkMora>();
+            string? pending = null;
+            foreach (var raw in text.Split(' ', StringSplitOptions.RemoveEmptyEntries)) {
+                var part = raw == Nasal ? raw : raw.ToLowerInvariant();
+                if (consonantTokens.Contains(part)) {
+                    if (pending != null) {
+                        return false;
+                    }
+                    pending = part;
+                } else if (vowelTokens.Contains(part) || part == Nasal || part == Geminate) {
+                    result.Add(new CoeiroinkMora(pending, part));
+                    pending = null;
+                } else {
+                    return false;
+                }
+            }
+            if (pending != null || result.Count == 0) {
+                return false;
+            }
+            moras = result.ToArray();
+            return true;
+        }
+    }
+}
diff --git a/OpenUtau.Core/Coeiroink/CoeiroinkModel.cs b/OpenUtau.Core/Coeiroink/CoeiroinkModel.cs
new file mode 100644
--- /dev/null
+++ b/OpenUtau.Core/Coeiroink/CoeiroinkModel.cs
@@ -0,0 +1,120 @@
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using Microsoft.ML.OnnxRuntime;
+using Microsoft.ML.OnnxRuntime.Tensors;
+using OpenUtau.Core.Util;
+
+namespace OpenUtau.Core.Coeiroink {
+    public class CoeiroinkModel : IDisposable {
+        public const float FlowNoiseScale = 0.333f;
+        public const float DurationNoiseScale = 0.333f;
+
+        static readonly ConcurrentDictionary<string, CoeiroinkModel> cache = new ConcurrentDictionary<string, CoeiroinkModel>();
+
+        public readonly CoeiroinkModelConfig Config;
+        public readonly Dictionary<string, long> TokenIds;
+        readonly InferenceSession durationSession;
+        readonly InferenceSession synthSession;
+        readonly object runLock = new object();
+
+        CoeiroinkModel(CoeiroinkStyle style) {
+            if (!style.IsExported) {
+                throw new FileNotFoundException(
+                    $"ONNX models for the COEIROINK style \"{style.Name}\" were not found in {style.ModelDir}. " +
+                    $"Export them with the tool from {CoeiroinkConfig.ExporterUrl}");
+            }
+            Config = CoeiroinkModelConfig.Load(style.ConfigPath);
+            TokenIds = Config.TokenIds();
+            using var scope = Onnx.EnterDmlScope();
+            durationSession = Onnx.getInferenceSession(style.DurationModelPath);
+            synthSession = Onnx.getInferenceSession(style.SynthModelPath);
+        }
+
+        public static CoeiroinkModel Get(CoeiroinkStyle style) {
+            return cache.GetOrAdd(style.ModelDir, _ => new CoeiroinkModel(style));
+        }
+
+        public static void Evict(string modelDir) {
+            if (cache.TryRemove(modelDir, out var model)) {
+                model.Dispose();
+            }
+        }
+
+        public bool TryEncode(IEnumerable<string> tokens, out long[] ids) {
+            var list = new List<long>();
+            foreach (var token in tokens) {
+                if (!TokenIds.TryGetValue(token, out var id)) {
+                    ids = Array.Empty<long>();
+                    return false;
+                }
+                list.Add(id);
+            }
+            ids = list.ToArray();
+            return true;
+        }
+
+        public float[] PredictDurations(long[] ids, int seed, CancellationToken token = default) {
+            var random = new Random(seed);
+            var noise = new DenseTensor<float>(new[] { 1, 2, ids.Length });
+            for (int i = 0; i < noise.Length; i++) {
+                noise.SetValue(i, (float)(NextGaussian(random) * DurationNoiseScale));
+            }
+            var inputs = new List<NamedOnnxValue> {
+                NamedOnnxValue.CreateFromTensor("text", new DenseTensor<long>(ids, new[] { 1, ids.Length })),
+                NamedOnnxValue.CreateFromTensor("noise", noise),
+            };
+            lock (runLock) {
+                using var scope = Onnx.EnterDmlScope();
+                token.ThrowIfCancellationRequested();
+                using var options = new RunOptions();
+                using var registration = token.Register(() => options.Terminate = true);
+                using var results = durationSession.Run(inputs, durationSession.OutputNames, options);
+                token.ThrowIfCancellationRequested();
+                var output = results.First().AsTensor<float>().ToArray();
+                if (output.Any(v => !float.IsFinite(v))) { throw new InvalidDataException("COEIROINK returned non-finite samples."); }
+                return output;
+            }
+        }
+
+        public float[] Synthesize(long[] ids, int[] frames, int seed, float noiseScale = FlowNoiseScale, CancellationToken token = default) {
+            int totalFrames = frames.Sum();
+            var random = new Random(seed);
+            var noise = new DenseTensor<float>(new[] { 1, Config.HiddenChannels, totalFrames });
+            for (int i = 0; i < noise.Length; i++) {
+                noise.SetValue(i, (float)NextGaussian(random));
+            }
+            var inputs = new List<NamedOnnxValue> {
+                NamedOnnxValue.CreateFromTensor("text", new DenseTensor<long>(ids, new[] { 1, ids.Length })),
+                NamedOnnxValue.CreateFromTensor("duration", new DenseTensor<float>(frames.Select(f => (float)f).ToArray(), new[] { ids.Length })),
+                NamedOnnxValue.CreateFromTensor("noise", noise),
+                NamedOnnxValue.CreateFromTensor("noise_scale", new DenseTensor<float>(new[] { noiseScale }, Array.Empty<int>())),
+            };
+            lock (runLock) {
+                using var scope = Onnx.EnterDmlScope();
+                token.ThrowIfCancellationRequested();
+                using var options = new RunOptions();
+                using var registration = token.Register(() => options.Terminate = true);
+                using var results = synthSession.Run(inputs, synthSession.OutputNames, options);
+                token.ThrowIfCancellationRequested();
+                var output = results.First().AsTensor<float>().ToArray();
+                if (output.Any(v => !float.IsFinite(v))) { throw new InvalidDataException("COEIROINK returned non-finite samples."); }
+                return output;
+            }
+        }
+
+        static double NextGaussian(Random random) {
+            double u1 = 1.0 - random.NextDouble();
+            double u2 = random.NextDouble();
+            return Math.Sqrt(-2.0 * Math.Log(u1)) * Math.Cos(2.0 * Math.PI * u2);
+        }
+
+        public void Dispose() {
+            durationSession.Dispose();
+            synthSession.Dispose();
+        }
+    }
+}
diff --git a/OpenUtau.Core/Coeiroink/CoeiroinkPhonemizer.cs b/OpenUtau.Core/Coeiroink/CoeiroinkPhonemizer.cs
new file mode 100644
--- /dev/null
+++ b/OpenUtau.Core/Coeiroink/CoeiroinkPhonemizer.cs
@@ -0,0 +1,40 @@
+using System;
+using System.Collections.Generic;
+using OpenUtau.Api;
+using OpenUtau.Core.Ustx;
+
+namespace OpenUtau.Core.Coeiroink {
+    [Phonemizer("COEIROINK Japanese Phonemizer", "COEIROINK JA", language: "JA")]
+    public class CoeiroinkPhonemizer : Phonemizer {
+        public override void SetSinger(USinger singer) { }
+
+        public override Result Process(Note[] notes, Note? prev, Note? next, Note? prevNeighbour, Note? nextNeighbour, Note[] prevNeighbours) {
+            var phonemes = new List<Phoneme>();
+            foreach (var note in notes) {
+                var lyric = string.IsNullOrEmpty(note.phoneticHint) ? note.lyric : note.phoneticHint;
+                if (string.IsNullOrWhiteSpace(lyric) || CoeiroinkKana.IsExtension(lyric)) {
+                    continue;
+                }
+                if (CoeiroinkKana.IsRest(lyric)) {
+                    phonemes.Add(new Phoneme { phoneme = CoeiroinkKana.PausePhoneme, position = note.position - notes[0].position });
+                    continue;
+                }
+                if (!CoeiroinkKana.TryParse(lyric, out var moras)) {
+                    throw new Exception($"Unrecognized lyric \"{lyric}\"");
+                }
+                int offset = note.position - notes[0].position;
+                if (moras.Length == 1) {
+                    phonemes.Add(new Phoneme { phoneme = lyric.Trim(), position = offset });
+                    continue;
+                }
+                for (int i = 0; i < moras.Length; i++) {
+                    phonemes.Add(new Phoneme {
+                        phoneme = moras[i].ToString(),
+                        position = offset + note.duration * i / moras.Length,
+                    });
+                }
+            }
+            return new Result { phonemes = phonemes.ToArray() };
+        }
+    }
+}
diff --git a/OpenUtau.Core/Coeiroink/CoeiroinkPlusPhonemizer.cs b/OpenUtau.Core/Coeiroink/CoeiroinkPlusPhonemizer.cs
new file mode 100644
--- /dev/null
+++ b/OpenUtau.Core/Coeiroink/CoeiroinkPlusPhonemizer.cs
@@ -0,0 +1,49 @@
+using System;
+using System.Collections.Generic;
+using OpenUtau.Api;
+using OpenUtau.Core.Ustx;
+
+namespace OpenUtau.Core.Coeiroink {
+    [Phonemizer("COEIROINK Japanese Phonemizer Plus", "COEIROINK JA+", language: "JA")]
+    public class CoeiroinkPlusPhonemizer : Phonemizer {
+        public override void SetSinger(USinger singer) { }
+
+        public override Result Process(Note[] notes, Note? prev, Note? next, Note? prevNeighbour, Note? nextNeighbour, Note[] prevNeighbours) {
+            var phonemes = new List<Phoneme>();
+            foreach (var note in notes) {
+                var lyric = string.IsNullOrEmpty(note.phoneticHint) ? note.lyric : note.phoneticHint;
+                if (string.IsNullOrWhiteSpace(lyric) || CoeiroinkKana.IsExtension(lyric)) {
+                    continue;
+                }
+                if (CoeiroinkKana.IsRest(lyric)) {
+                    phonemes.Add(new Phoneme { phoneme = CoeiroinkKana.PausePhoneme, position = note.position - notes[0].position });
+                    continue;
+                }
+                if (!CoeiroinkKana.TryParse(lyric, out var moras)) {
+                    throw new Exception($"Unrecognized lyric \"{lyric}\"");
+                }
+                int offset = note.position - notes[0].position;
+                for (int i = 0; i < moras.Length; i++) {
+                    int position = offset + note.duration * i / moras.Length;
+                    var mora = moras[i];
+                    if (mora.Consonant == null || mora.IsGeminate) {
+                        phonemes.Add(new Phoneme { phoneme = moras.Length == 1 ? lyric.Trim() : mora.ToString(), position = position });
+                        continue;
+                    }
+                    int moraDuration = note.duration / moras.Length;
+                    int lead = ConsonantTicks(mora.Consonant, notes[0].position + position, moraDuration);
+                    phonemes.Add(new Phoneme { phoneme = mora.Consonant + mora.Vowel, position = position });
+                    phonemes.Add(new Phoneme { phoneme = mora.Vowel, position = position + lead });
+                }
+            }
+            return new Result { phonemes = phonemes.ToArray() };
+        }
+
+        int ConsonantTicks(string consonant, int tickPosition, int moraDuration) {
+            double startMs = timeAxis.TickPosToMsPos(tickPosition);
+            double consonantMs = CoeiroinkKana.DefaultConsonantMs(consonant);
+            int ticks = timeAxis.MsPosToTickPos(startMs + consonantMs) - tickPosition;
+            return Math.Clamp(ticks, 1, Math.Max(1, moraDuration / 2));
+        }
+    }
+}
diff --git a/OpenUtau.Core/Coeiroink/CoeiroinkRenderer.cs b/OpenUtau.Core/Coeiroink/CoeiroinkRenderer.cs
new file mode 100644
--- /dev/null
+++ b/OpenUtau.Core/Coeiroink/CoeiroinkRenderer.cs
@@ -0,0 +1,277 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using K4os.Hash.xxHash;
+using NAudio.Wave;
+using OpenUtau.Classic.Hifisampler;
+using OpenUtau.Core.Format;
+using OpenUtau.Core.Render;
+using OpenUtau.Core.Ustx;
+using Serilog;
+
+namespace OpenUtau.Core.Coeiroink {
+    public class CoeiroinkRenderer : IRenderer {
+        public const double HeadMs = 160;
+        public const double TailMs = 120;
+        const int OutputSampleRate = 44100;
+        const int CurveInterval = 5;
+        const int CacheVersion = 5;
+
+        static readonly HashSet<string> supportedExp = new HashSet<string>() {
+            Format.Ustx.DYN,
+            Format.Ustx.PITD,
+            Format.Ustx.CLR,
+            Format.Ustx.GENC,
+        };
+
+        static readonly object lockObj = new object();
+
+        public USingerType SingerType => USingerType.Coeiroink;
+
+        public bool SupportsRenderPitch => false;
+
+        public bool SupportsExpression(UExpressionDescriptor descriptor) {
+            return supportedExp.Contains(descriptor.abbr);
+        }
+
+        public (double HeadMs, double TailMs) PhrasePadding(USinger singer, IEnumerable<UPhoneme> phonemes) {
+            return (HeadMs, TailMs);
+        }
+
+        public RenderResult Layout(RenderPhrase phrase) {
+            return new RenderResult() {
+                leadingMs = HeadMs,
+                positionMs = phrase.positionMs,
+                estimatedLengthMs = HeadMs + phrase.durationMs + TailMs,
+            };
+        }
+
+        public Task<RenderResult> Render(RenderPhrase phrase, Progress progress, int trackNo, CancellationTokenSource cancellation, bool isPreRender, RenderPhraseEvents? renderEvents = null) {
+            return Task.Run(() => {
+                lock (lockObj) {
+                    if (cancellation.IsCancellationRequested) {
+                        return new RenderResult();
+                    }
+                    string progressInfo = $"Track {trackNo + 1}: {this} \"{string.Join(" ", phrase.phones.Select(p => p.phoneme))}\"";
+                    progress.Complete(0, progressInfo);
+                    var wavPath = Path.Join(PathManager.Inst.CachePath, $"coe-{phrase.hash:x16}-{CacheVersion}.wav");
+                    phrase.AddCacheFile(wavPath);
+                    var result = Layout(phrase);
+                    if (!File.Exists(wavPath)) {
+                        var samples = Synthesize(phrase, cancellation);
+                        if (samples == null || cancellation.IsCancellationRequested) {
+                            return new RenderResult();
+                        }
+                        if (samples.Length == 0 || samples.Any(v => !float.IsFinite(v))) {
+                            throw new InvalidDataException("COEIROINK returned invalid audio.");
+                        }
+                        string temporary = wavPath + "." + Guid.NewGuid().ToString("N") + ".tmp";
+                        try {
+                            Wave.WriteMono16Wav(temporary, samples);
+                            cancellation.Token.ThrowIfCancellationRequested();
+                            File.Move(temporary, wavPath, true);
+                        } finally { if (File.Exists(temporary)) { File.Delete(temporary); } }
+                    }
+                    progress.Complete(phrase.phones.Length, progressInfo);
+                    using (var waveStream = new WaveFileReader(wavPath)) {
+                        result.samples = Wave.GetSamples(waveStream.ToSampleProvider().ToMono(1, 0));
+                    }
+                    Renderers.ApplyDynamics(phrase, result);
+                    return result;
+                }
+            });
+        }
+
+        float[]? Synthesize(RenderPhrase phrase, CancellationTokenSource cancellation) {
+            var singer = phrase.singer as CoeiroinkSinger;
+            if (singer == null || phrase.phones.Length == 0) {
+                return null;
+            }
+            singer.EnsureLoaded();
+            var style = singer.GetStyle(phrase.phones[0].suffix);
+            if (style == null) {
+                throw new MessageCustomizableException("The COEIROINK voicebank has no styles.", "metas.json has no styles.", new InvalidDataException());
+            }
+            CoeiroinkModel model;
+            try {
+                model = CoeiroinkModel.Get(style);
+            } catch (FileNotFoundException e) {
+                throw new MessageCustomizableException("COEIROINK ONNX models were not found. Export them with the exporter tool.", e.Message, e);
+            }
+
+            var syllables = BuildSyllables(phrase);
+            if (syllables.Count == 0) {
+                return new float[(int)Math.Ceiling((HeadMs + phrase.durationMs + TailMs) * OutputSampleRate / 1000)];
+            }
+            var plan = CoeiroinkTimeline.BuildPlan(syllables);
+            if (!model.TryEncode(plan.Tokens, out var ids)) {
+                var missing = plan.Tokens.Where(t => !model.TokenIds.ContainsKey(t)).Distinct();
+                throw new MessageCustomizableException(
+                    $"The COEIROINK model does not know the tokens: {string.Join(" ", missing)}",
+                    $"Unsupported tokens: {string.Join(" ", missing)}",
+                    new InvalidDataException());
+            }
+            int seed = Seed(ids);
+            var predicted = model.PredictDurations(ids, seed, cancellation.Token);
+            if (cancellation.IsCancellationRequested) {
+                return null;
+            }
+            double startMs = phrase.positionMs - HeadMs;
+            var frames = CoeiroinkTimeline.Allocate(plan, syllables, predicted, startMs, model.Config.FrameMs);
+            var wave = model.Synthesize(ids, frames, seed, token: cancellation.Token);
+            if (cancellation.IsCancellationRequested) {
+                return null;
+            }
+            return Vocode(phrase, wave, startMs, model.Config.FrameMs, VoicedMask(plan, frames));
+        }
+
+        static List<CoeiroinkSyllable> BuildSyllables(RenderPhrase phrase) {
+            var syllables = new List<CoeiroinkSyllable>();
+            var phones = phrase.phones;
+            string? pendingConsonant = null;
+            double pendingConsonantMs = 0;
+            bool pendingPause = false;
+            for (int p = 0; p < phones.Length; p++) {
+                var phone = phones[p];
+                if (CoeiroinkKana.IsRest(phone.phoneme)) {
+                    pendingPause = syllables.Count > 0;
+                    pendingConsonant = null;
+                    continue;
+                }
+                if (CoeiroinkKana.IsConsonantToken(phone.phoneme)) {
+                    pendingConsonant = phone.phoneme.Trim();
+                    pendingConsonantMs = phone.endMs - phone.positionMs;
+                    continue;
+                }
+                if (!CoeiroinkKana.TryParse(phone.phoneme, out var moras)) {
+                    Log.Warning($"Skipped an unrecognized COEIROINK phoneme \"{phone.phoneme}\"");
+                    continue;
+                }
+                if (moras.Length == 1 && moras[0].Consonant != null && !moras[0].IsGeminate
+                    && p + 1 < phones.Length && phones[p + 1].noteIndex == phone.noteIndex
+                    && CoeiroinkKana.TryParse(phones[p + 1].phoneme, out var vowelMoras)
+                    && vowelMoras.Length == 1 && vowelMoras[0].Consonant == null && vowelMoras[0].Vowel == moras[0].Vowel) {
+                    var vowel = phones[p + 1];
+                    syllables.Add(new CoeiroinkSyllable {
+                        PauseBefore = pendingPause,
+                        ConsonantMs = vowel.positionMs - phone.positionMs,
+                        Mora = moras[0],
+                        StartMs = vowel.positionMs,
+                        EndMs = vowel.endMs,
+                        Tone = vowel.tone,
+                    });
+                    p++;
+                    pendingConsonant = null;
+                    pendingPause = false;
+                    continue;
+                }
+                double step = (phone.endMs - phone.positionMs) / moras.Length;
+                for (int i = 0; i < moras.Length; i++) {
+                    var mora = moras[i];
+                    double? consonantMs = null;
+                    if (i == 0 && pendingConsonant != null && mora.Consonant == null && !mora.IsGeminate) {
+                        mora = new CoeiroinkMora(pendingConsonant, mora.Vowel);
+                        consonantMs = pendingConsonantMs;
+                    }
+                    syllables.Add(new CoeiroinkSyllable {
+                        PauseBefore = pendingPause && i == 0,
+                        ConsonantMs = consonantMs,
+                        Mora = mora,
+                        StartMs = phone.positionMs + step * i,
+                        EndMs = phone.positionMs + step * (i + 1),
+                        Tone = phone.tone,
+                    });
+                }
+                pendingConsonant = null;
+                pendingPause = false;
+            }
+            return syllables;
+        }
+
+        static int Seed(long[] ids) {
+            var bytes = new byte[ids.Length * sizeof(long)];
+            Buffer.BlockCopy(ids, 0, bytes, 0, bytes.Length);
+            return (int)(XXH64.DigestOf(bytes) & 0x7fffffff);
+        }
+
+        static readonly HashSet<string> voicedConsonants = new HashSet<string> {
+            "m", "n", "ny", "my", "r", "ry", "y", "w", "g", "gy", "z", "j", "d", "dy", "b", "by", "v",
+        };
+
+        static bool[] VoicedMask(CoeiroinkTokenPlan plan, int[] frames) {
+            var mask = new bool[frames.Sum()];
+            int cursor = 0;
+            for (int i = 0; i < frames.Length; i++) {
+                bool voiced = plan.Roles[i] switch {
+                    CoeiroinkTokenRole.Vowel => plan.Tokens[i] != CoeiroinkKana.Geminate,
+                    CoeiroinkTokenRole.Consonant => voicedConsonants.Contains(plan.Tokens[i]),
+                    _ => false,
+                };
+                Array.Fill(mask, voiced, cursor, frames[i]);
+                cursor += frames[i];
+            }
+            return mask;
+        }
+
+        float[] Vocode(RenderPhrase phrase, float[] wave, double startMs, double frameMs, bool[] voiced) {
+            var vocoder = HifiVocoder.Instance;
+            var config = vocoder.Config;
+            if (config.sample_rate != OutputSampleRate || Math.Abs(config.hop_size - frameMs * OutputSampleRate / 1000) > 0.5) {
+                throw new MessageCustomizableException(
+                    "The vocoder must be 44.1 kHz with hop size 512.",
+                    $"Vocoder {config.name} is {config.sample_rate} Hz with hop {config.hop_size}.",
+                    new InvalidDataException());
+            }
+            int frames = HifiMelSpectrogram.FrameCount(wave.Length, config.hop_size);
+            var gender = SampleCurve(phrase, phrase.gender, 0, startMs + frameMs / 2, frameMs, frames, x => -0.12 * Math.Clamp(x, -100, 100));
+            var analyzer = new HifiMelSpectrogram(config.sample_rate, config.fft_size, config.win_size, config.hop_size, config.mel_fmin, config.mel_fmax, config.num_mel_bins);
+            var mel = analyzer.Compute(wave, gender);
+            HifiMelSpectrogram.LogCompress(mel);
+            var f0 = SampleCurve(phrase, phrase.pitches, 0, startMs + frameMs / 2, frameMs, frames, x => MusicMath.ToneToFreq(x * 0.01));
+            for (int i = 0; i < frames; i++) {
+                if (i >= voiced.Length || !voiced[i]) {
+                    f0[i] = 0;
+                }
+            }
+            var synthesized = vocoder.Synthesize(mel, f0);
+            var result = new float[wave.Length];
+            Array.Copy(synthesized, result, Math.Min(synthesized.Length, result.Length));
+            float peak = result.Length == 0 ? 0 : result.Max(Math.Abs);
+            if (peak > 0.99f) {
+                float scale = 0.99f / peak;
+                for (int i = 0; i < result.Length; i++) {
+                    result[i] *= scale;
+                }
+            }
+            return result;
+        }
+
+        static double[] SampleCurve(RenderPhrase phrase, float[] curve, double defaultValue, double startMs, double frameMs, int length, Func<double, double> convert) {
+            var result = new double[length];
+            if (curve == null || curve.Length == 0) {
+                Array.Fill(result, defaultValue);
+                return result;
+            }
+            int origin = phrase.position - phrase.leading;
+            for (int i = 0; i < length; i++) {
+                int ticks = phrase.timeAxis.MsPosToTickPos(startMs + i * frameMs) - origin;
+                int index = Math.Clamp(ticks / CurveInterval, 0, curve.Length - 1);
+                result[i] = convert(curve[index]);
+            }
+            return result;
+        }
+
+        public UExpressionDescriptor[] GetSuggestedExpressions(USinger singer, URenderSettings renderSettings) {
+            return Array.Empty<UExpressionDescriptor>();
+        }
+
+        public RenderPitchResult LoadRenderedPitch(RenderPhrase phrase) {
+            return null;
+        }
+
+        public override string ToString() => Renderers.COEIROINK;
+    }
+}
diff --git a/OpenUtau.Core/Coeiroink/CoeiroinkSinger.cs b/OpenUtau.Core/Coeiroink/CoeiroinkSinger.cs
new file mode 100644
--- /dev/null
+++ b/OpenUtau.Core/Coeiroink/CoeiroinkSinger.cs
@@ -0,0 +1,183 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Text;
+using OpenUtau.Classic;
+using OpenUtau.Core.Ustx;
+using Serilog;
+
+namespace OpenUtau.Core.Coeiroink {
+    public class CoeiroinkSinger : USinger {
+        public override string Id => voicebank.Id;
+        public override string Name => voicebank.Name;
+        public override Dictionary<string, string> LocalizedNames => voicebank.LocalizedNames;
+        public override IList<string> SearchTerms => voicebank.SearchTerms;
+        public override USingerType SingerType => voicebank.SingerType;
+        public override string BasePath => voicebank.BasePath;
+        public override string Author => voicebank.Author;
+        public override string Voice => voicebank.Voice;
+        public override string Location => Path.GetDirectoryName(voicebank.File);
+        public override string Web => voicebank.Web;
+        public override string Version => string.IsNullOrEmpty(voicebank.Version) ? config?.Version ?? string.Empty : voicebank.Version;
+        public override string OtherInfo => voicebank.OtherInfo;
+        public override IList<string> Errors => errors;
+        public override string Avatar => AvatarPath();
+        public override byte[] AvatarData => avatarData;
+        public override string Portrait => PortraitPath();
+        public override float PortraitOpacity => voicebank.PortraitOpacity;
+        public override int PortraitHeight => voicebank.PortraitHeight;
+        public override string Sample => voicebank.Sample == null ? SampleFromFolder() : Path.Combine(Location, voicebank.Sample);
+        public override string DefaultPhonemizer => voicebank.DefaultPhonemizer;
+        public override Encoding TextFileEncoding => voicebank.TextFileEncoding;
+        public override IList<USubbank> Subbanks => subbanks;
+        public override IList<UOto> Otos => otos;
+
+        public CoeiroinkConfig? Config => config;
+
+        Voicebank voicebank;
+        CoeiroinkConfig? config;
+        List<string> errors = new List<string>();
+        List<USubbank> subbanks = new List<USubbank>();
+        List<UOto> otos = new List<UOto>();
+        byte[]? avatarData;
+
+        public CoeiroinkSinger(Voicebank voicebank) {
+            this.voicebank = voicebank;
+            found = true;
+        }
+
+        public override void EnsureLoaded() {
+            if (Loaded) {
+                return;
+            }
+            Reload();
+        }
+
+        public override void Reload() {
+            if (!Found) {
+                return;
+            }
+            errors.Clear();
+            try {
+                voicebank.Reload();
+                Load();
+                loaded = true;
+            } catch (Exception e) {
+                errors.Add($"Failed to load {voicebank.File}: {e.Message}");
+                Log.Error(e, $"Failed to load {voicebank.File}");
+            }
+        }
+
+        void Load() {
+            config = CoeiroinkConfig.Load(Location);
+            subbanks.Clear();
+            otos.Clear();
+            subbanks.Add(new USubbank(new Subbank() {
+                Prefix = string.Empty,
+                Suffix = string.Empty,
+                ToneRanges = new[] { "C1-B7" },
+                Color = string.Empty,
+            }));
+            foreach (var style in config.Styles) {
+                subbanks.Add(new USubbank(new Subbank() {
+                    Prefix = string.Empty,
+                    Suffix = style.Name,
+                    ToneRanges = new[] { "C1-B7" },
+                    Color = style.Name,
+                }));
+                if (!style.IsExported) {
+                    errors.Add($"ONNX models of the style \"{style.Name}\" are missing. Export them with {CoeiroinkConfig.ExporterUrl}");
+                }
+            }
+            if (config.Styles.Count == 0) {
+                errors.Add("metas.json has no styles.");
+            }
+            var seen = new HashSet<string>();
+            foreach (var kana in CoeiroinkKana.AllKana) {
+                if (seen.Add(kana)) {
+                    otos.Add(UOto.OfDummy(kana));
+                }
+            }
+            LoadAvatar();
+        }
+
+        public CoeiroinkStyle? GetStyle(string? suffix) {
+            if (config == null || config.Styles.Count == 0) {
+                return null;
+            }
+            if (!string.IsNullOrEmpty(suffix)) {
+                var match = config.Styles.FirstOrDefault(s => s.Name == suffix);
+                if (match != null) {
+                    return match;
+                }
+            }
+            return config.Styles[0];
+        }
+
+        string AvatarPath() {
+            if (voicebank.Image != null) {
+                return Path.Combine(Location, voicebank.Image);
+            }
+            return config?.Styles.FirstOrDefault(s => File.Exists(s.Icon))?.Icon;
+        }
+
+        string PortraitPath() {
+            if (voicebank.Portrait != null) {
+                return Path.Combine(Location, voicebank.Portrait);
+            }
+            var path = Path.Combine(Location, "portrait.png");
+            return File.Exists(path) ? path : null;
+        }
+
+        string SampleFromFolder() {
+            var dir = Path.Combine(Location, "voice_samples");
+            if (!Directory.Exists(dir)) {
+                return null;
+            }
+            return Directory.EnumerateFiles(dir, "*.wav").OrderBy(f => f, StringComparer.OrdinalIgnoreCase).FirstOrDefault();
+        }
+
+        void LoadAvatar() {
+            var path = Avatar;
+            if (path != null && File.Exists(path)) {
+                try {
+                    avatarData = File.ReadAllBytes(path);
+                } catch (Exception e) {
+                    avatarData = null;
+                    Log.Error(e, "Failed to load avatar data.");
+                }
+            } else {
+                avatarData = null;
+            }
+        }
+
+        public override bool TryGetOto(string phoneme, out UOto oto) {
+            if (phoneme != null && (CoeiroinkKana.TryParse(phoneme, out _) || CoeiroinkKana.IsConsonantToken(phoneme) || CoeiroinkKana.IsRest(phoneme))) {
+                oto = UOto.OfDummy(phoneme);
+                return true;
+            }
+            oto = null;
+            return false;
+        }
+
+        public override Dictionary<string, UOto> GetSuggestions(string text, bool isAlias) {
+            bool all = string.IsNullOrEmpty(text);
+            return otos
+                .Where(o => all || o.Alias.Contains(text))
+                .ToDictionary(o => o.Alias, o => o);
+        }
+
+        public override byte[] LoadPortrait() {
+            return string.IsNullOrEmpty(Portrait) || !File.Exists(Portrait)
+                ? null
+                : File.ReadAllBytes(Portrait);
+        }
+
+        public override byte[] LoadSample() {
+            return string.IsNullOrEmpty(Sample) || !File.Exists(Sample)
+                ? null
+                : File.ReadAllBytes(Sample);
+        }
+    }
+}
diff --git a/OpenUtau.Core/Coeiroink/CoeiroinkTimeline.cs b/OpenUtau.Core/Coeiroink/CoeiroinkTimeline.cs
new file mode 100644
--- /dev/null
+++ b/OpenUtau.Core/Coeiroink/CoeiroinkTimeline.cs
@@ -0,0 +1,213 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace OpenUtau.Core.Coeiroink {
+    public class CoeiroinkSyllable {
+        public CoeiroinkMora Mora;
+        public double StartMs;
+        public double EndMs;
+        public int Tone;
+        public double? ConsonantMs;
+        public bool PauseBefore;
+    }
+
+    public enum CoeiroinkTokenRole {
+        Start,
+        Boundary,
+        Pause,
+        Consonant,
+        Vowel,
+        Marker,
+        End,
+    }
+
+    public class CoeiroinkTokenPlan {
+        public readonly List<string> Tokens = new List<string>();
+        public readonly List<CoeiroinkTokenRole> Roles = new List<CoeiroinkTokenRole>();
+        public readonly List<int> MoraIndexes = new List<int>();
+
+        public void Add(string token, CoeiroinkTokenRole role, int mora) {
+            Tokens.Add(token);
+            Roles.Add(role);
+            MoraIndexes.Add(mora);
+        }
+    }
+
+    public static class CoeiroinkTimeline {
+        public const string StartToken = "^";
+        public const string EndToken = "$";
+        public const string PauseToken = "_";
+        public const string BoundaryToken = "#";
+        public const string FallToken = "]";
+
+        public const double PauseThresholdMs = 50;
+        public const int MaxPhraseMoras = 8;
+        public const int MaxConsonantFrames = 14;
+        public const int MaxMarkerFrames = 3;
+        public const int TailFrames = 9;
+
+        public static CoeiroinkTokenPlan BuildPlan(IReadOnlyList<CoeiroinkSyllable> syllables) {
+            var plan = new CoeiroinkTokenPlan();
+            plan.Add(StartToken, CoeiroinkTokenRole.Start, -1);
+            var markers = BuildMarkers(syllables);
+            for (int k = 0; k < syllables.Count; k++) {
+                var mora = syllables[k].Mora;
+                if (k > 0) {
+                    if (IsPause(syllables, k)) {
+                        plan.Add(PauseToken, CoeiroinkTokenRole.Pause, k);
+                    } else if (markers.PhraseStarts.Contains(k)) {
+                        plan.Add(BoundaryToken, CoeiroinkTokenRole.Boundary, k);
+                    }
+                }
+                if (mora.Consonant != null) {
+                    plan.Add(mora.Consonant, CoeiroinkTokenRole.Consonant, k);
+                }
+                plan.Add(mora.Vowel, CoeiroinkTokenRole.Vowel, k);
+                foreach (var marker in markers.After[k]) {
+                    plan.Add(marker, CoeiroinkTokenRole.Marker, k);
+                }
+            }
+            plan.Add(EndToken, CoeiroinkTokenRole.End, syllables.Count);
+            return plan;
+        }
+
+        static bool IsPause(IReadOnlyList<CoeiroinkSyllable> syllables, int k) {
+            return syllables[k].PauseBefore || syllables[k].StartMs - syllables[k - 1].EndMs >= PauseThresholdMs;
+        }
+
+        class Markers {
+            public readonly HashSet<int> PhraseStarts = new HashSet<int>();
+            public List<string>[] After = Array.Empty<List<string>>();
+        }
+
+        static Markers BuildMarkers(IReadOnlyList<CoeiroinkSyllable> syllables) {
+            var markers = new Markers { After = Enumerable.Range(0, syllables.Count).Select(_ => new List<string>()).ToArray() };
+            int start = 0;
+            for (int k = 1; k <= syllables.Count; k++) {
+                bool end = k == syllables.Count;
+                bool pause = !end && IsPause(syllables, k);
+                bool forced = !end && k - start >= MaxPhraseMoras;
+                if (end || pause || forced) {
+                    AddAccent(syllables, start, k, markers);
+                    if (!end) {
+                        markers.PhraseStarts.Add(k);
+                    }
+                    start = k;
+                }
+            }
+            return markers;
+        }
+
+        static void AddAccent(IReadOnlyList<CoeiroinkSyllable> syllables, int start, int end, Markers markers) {
+            int count = end - start;
+            if (count < 2) {
+                return;
+            }
+            var tones = Enumerable.Range(start, count).Select(i => syllables[i].Tone).ToArray();
+            int max = tones.Max();
+            int min = tones.Min();
+            if (max == min) {
+                return;
+            }
+            int high = Array.IndexOf(tones, max);
+            int nucleus = high;
+            while (nucleus + 1 < count && tones[nucleus + 1] >= max - 1) {
+                nucleus++;
+            }
+            if (nucleus < count - 1) {
+                markers.After[start + nucleus].Add(FallToken);
+            }
+        }
+
+        public static int[] Allocate(
+            CoeiroinkTokenPlan plan,
+            IReadOnlyList<CoeiroinkSyllable> syllables,
+            IReadOnlyList<float> predicted,
+            double startMs,
+            double frameMs) {
+            int count = syllables.Count;
+            var anchors = new int[count];
+            var ends = new int[count];
+            for (int k = 0; k < count; k++) {
+                int minAnchor = k == 0 ? 2 : anchors[k - 1] + 3;
+                anchors[k] = Math.Max(minAnchor, (int)Math.Round((syllables[k].StartMs - startMs) / frameMs));
+                ends[k] = Math.Max(anchors[k] + 2, (int)Math.Round((syllables[k].EndMs - startMs) / frameMs));
+            }
+
+            var consonant = new int[count];
+            var boundary = new int[count];
+            var markerFrames = new int[count];
+            var pause = new bool[count];
+            for (int i = 0; i < plan.Tokens.Count; i++) {
+                int k = plan.MoraIndexes[i];
+                int frames = Math.Max(1, (int)Math.Ceiling(predicted[i]));
+                switch (plan.Roles[i]) {
+                    case CoeiroinkTokenRole.Consonant: {
+                        int available = k == 0 ? anchors[0] - 1 : (anchors[k] - anchors[k - 1]) / 2;
+                        if (syllables[k].ConsonantMs.HasValue) {
+                            frames = Math.Max(1, (int)Math.Round(syllables[k].ConsonantMs.Value / frameMs));
+                        }
+                        consonant[k] = Math.Clamp(frames, 1, Math.Max(1, Math.Min(MaxConsonantFrames, available)));
+                        break;
+                    }
+                    case CoeiroinkTokenRole.Boundary:
+                        boundary[k] = Math.Min(frames, MaxMarkerFrames);
+                        break;
+                    case CoeiroinkTokenRole.Pause:
+                        pause[k] = true;
+                        break;
+                    case CoeiroinkTokenRole.Marker:
+                        markerFrames[k] += Math.Min(frames, MaxMarkerFrames);
+                        break;
+                }
+            }
+
+            int PreStart(int k) => anchors[k] - consonant[k] - boundary[k];
+
+            var result = new int[plan.Tokens.Count];
+            for (int i = 0; i < plan.Tokens.Count; i++) {
+                int k = plan.MoraIndexes[i];
+                switch (plan.Roles[i]) {
+                    case CoeiroinkTokenRole.Start:
+                        result[i] = Math.Max(1, PreStart(0));
+                        break;
+                    case CoeiroinkTokenRole.Boundary:
+                        result[i] = boundary[k];
+                        break;
+                    case CoeiroinkTokenRole.Pause: {
+                        int vowelEnd = VowelEnd(k - 1);
+                        result[i] = Math.Max(1, PreStart(k) - vowelEnd);
+                        break;
+                    }
+                    case CoeiroinkTokenRole.Consonant:
+                        result[i] = consonant[k];
+                        break;
+                    case CoeiroinkTokenRole.Vowel: {
+                        int span = VowelEnd(k) - anchors[k] - markerFrames[k];
+                        result[i] = Math.Max(1, span);
+                        break;
+                    }
+                    case CoeiroinkTokenRole.Marker:
+                        result[i] = Math.Max(1, Math.Min(MaxMarkerFrames, (int)Math.Ceiling(predicted[i])));
+                        break;
+                    case CoeiroinkTokenRole.End:
+                        result[i] = TailFrames;
+                        break;
+                }
+            }
+            return result;
+
+            int VowelEnd(int k) {
+                if (k == count - 1) {
+                    return ends[k];
+                }
+                int limit = PreStart(k + 1);
+                if (pause[k + 1]) {
+                    return Math.Min(ends[k], limit - 1);
+                }
+                return limit;
+            }
+        }
+    }
+}
