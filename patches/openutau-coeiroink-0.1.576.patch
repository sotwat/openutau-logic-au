diff --git a/OpenUtau.Test/Core/Coeiroink/CoeiroinkKanaTest.cs b/OpenUtau.Test/Core/Coeiroink/CoeiroinkKanaTest.cs
new file mode 100644
--- /dev/null
+++ b/OpenUtau.Test/Core/Coeiroink/CoeiroinkKanaTest.cs
@@ -0,0 +1,62 @@
+using System.Linq;
+using Xunit;
+
+namespace OpenUtau.Core.Coeiroink {
+    public class CoeiroinkKanaTest {
+        static string Parse(string lyric) {
+            Assert.True(CoeiroinkKana.TryParse(lyric, out var moras), lyric);
+            return string.Join(" | ", moras.Select(m => m.ToString()));
+        }
+
+        [Theory]
+        [InlineData("か", "k a")]
+        [InlineData("カ", "k a")]
+        [InlineData("し", "sh i")]
+        [InlineData("ちゃ", "ch a")]
+        [InlineData("きょ", "ky o")]
+        [InlineData("ふぁ", "f a")]
+        [InlineData("てぃ", "t i")]
+        [InlineData("ゔぁ", "v a")]
+        [InlineData("を", "o")]
+        [InlineData("ん", "N")]
+        [InlineData("っ", "cl")]
+        [InlineData("あ", "a")]
+        public void ParsesSingleKana(string lyric, string expected) {
+            Assert.Equal(expected, Parse(lyric));
+        }
+
+        [Fact]
+        public void ParsesWordsAndLongVowels() {
+            Assert.Equal("k o | N | n i | ch i | w a", Parse("こんにちわ"));
+            Assert.Equal("k a | a", Parse("かー"));
+        }
+
+        [Theory]
+        [InlineData("ka", "k a")]
+        [InlineData("sha", "sh a")]
+        [InlineData("n", "N")]
+        [InlineData("k a", "k a")]
+        [InlineData("ky o", "ky o")]
+        [InlineData("N", "N")]
+        public void ParsesRomajiAndTokens(string lyric, string expected) {
+            Assert.Equal(expected, Parse(lyric));
+        }
+
+        [Theory]
+        [InlineData("hello")]
+        [InlineData("k")]
+        [InlineData("")]
+        public void RejectsUnknownText(string lyric) {
+            Assert.False(CoeiroinkKana.TryParse(lyric, out _));
+        }
+
+        [Fact]
+        public void RecognizesRestsAndExtensions() {
+            Assert.True(CoeiroinkKana.IsRest("R"));
+            Assert.True(CoeiroinkKana.IsRest("sp"));
+            Assert.True(CoeiroinkKana.IsExtension("+"));
+            Assert.True(CoeiroinkKana.IsExtension("ー"));
+            Assert.False(CoeiroinkKana.IsRest("か"));
+        }
+    }
+}
diff --git a/OpenUtau.Test/Core/Coeiroink/CoeiroinkPhonemizerTest.cs b/OpenUtau.Test/Core/Coeiroink/CoeiroinkPhonemizerTest.cs
new file mode 100644
--- /dev/null
+++ b/OpenUtau.Test/Core/Coeiroink/CoeiroinkPhonemizerTest.cs
@@ -0,0 +1,55 @@
+using System.Linq;
+using OpenUtau.Api;
+using OpenUtau.Core.Ustx;
+using Xunit;
+
+namespace OpenUtau.Core.Coeiroink {
+    public class CoeiroinkPhonemizerTest {
+        static Phonemizer.Result Process(Phonemizer phonemizer, params (string lyric, int position, int duration)[] notes) {
+            var project = new UProject();
+            project.timeAxis.BuildSegments(project);
+            var group = notes.Select(n => new Phonemizer.Note { lyric = n.lyric, position = n.position, duration = n.duration, tone = 60 }).ToArray();
+            phonemizer.SetUp(new[] { group }, project, new UTrack(project));
+            phonemizer.SetTiming(project.timeAxis);
+            return phonemizer.Process(group, null, null, null, null, new Phonemizer.Note[0]);
+        }
+
+        static string[] Names(Phonemizer.Result result) => result.phonemes.Select(p => p.phoneme).ToArray();
+
+        [Fact]
+        public void PlainPhonemizerKeepsOnePhonemePerMora() {
+            Assert.Equal(new[] { "ち" }, Names(Process(new CoeiroinkPhonemizer(), ("ち", 480, 480))));
+            Assert.Equal(new[] { "k a", "k u" }, Names(Process(new CoeiroinkPhonemizer(), ("かく", 0, 960))));
+        }
+
+        [Fact]
+        public void PlusPhonemizerSplitsConsonantFromVowelInsideTheNote() {
+            var result = Process(new CoeiroinkPlusPhonemizer(), ("ち", 480, 480));
+            Assert.Equal(new[] { "chi", "i" }, Names(result));
+            Assert.Equal(0, result.phonemes[0].position);
+            Assert.InRange(result.phonemes[1].position, 1, 240);
+        }
+
+        [Fact]
+        public void PlusPhonemizerKeepsPlainVowelsAndNasalsWhole() {
+            Assert.Equal(new[] { "あ" }, Names(Process(new CoeiroinkPlusPhonemizer(), ("あ", 0, 480))));
+            Assert.Equal(new[] { "ん" }, Names(Process(new CoeiroinkPlusPhonemizer(), ("ん", 0, 480))));
+        }
+
+        [Fact]
+        public void PlusPhonemizerSplitsEveryMoraOfAWord() {
+            var result = Process(new CoeiroinkPlusPhonemizer(), ("きゃく", 0, 960));
+            Assert.Equal(new[] { "kya", "a", "ku", "u" }, Names(result));
+        }
+
+        [Fact]
+        public void BothTurnRestsIntoPauAndSkipExtensions() {
+            foreach (Phonemizer phonemizer in new Phonemizer[] { new CoeiroinkPhonemizer(), new CoeiroinkPlusPhonemizer() }) {
+                foreach (var lyric in new[] { "R", "SP", "pau" }) {
+                    Assert.Equal(new[] { "pau" }, Names(Process(phonemizer, (lyric, 0, 480))));
+                }
+                Assert.Empty(Process(phonemizer, ("+", 0, 480)).phonemes);
+            }
+        }
+    }
+}
diff --git a/OpenUtau.Test/Core/Coeiroink/CoeiroinkRendererTest.cs b/OpenUtau.Test/Core/Coeiroink/CoeiroinkRendererTest.cs
new file mode 100644
--- /dev/null
+++ b/OpenUtau.Test/Core/Coeiroink/CoeiroinkRendererTest.cs
@@ -0,0 +1,156 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using OpenUtau.Classic;
+using OpenUtau.Core.Render;
+using OpenUtau.Core.Ustx;
+using OpenUtau.Core.Util;
+using Xunit;
+
+namespace OpenUtau.Core.Coeiroink {
+    [Collection(RenderSingletonCollection.Name)]
+    public class CoeiroinkRendererTest {
+        const string BankVariable = "COEIROINK_TEST_BANK";
+        const string OutputVariable = "COEIROINK_TEST_OUT";
+
+        static UProject NewProject(USinger singer) {
+            var project = Format.Ustx.Create();
+            project.RegisterExpression(new UExpressionDescriptor("engine", "eng", 0, 100, 0) { options = new[] { "" } });
+            project.RegisterExpression(new UExpressionDescriptor("volume", "vol", 0, 100, 100));
+            project.RegisterExpression(new UExpressionDescriptor("velocity", "vel", 0, 100, 100));
+            project.RegisterExpression(new UExpressionDescriptor("modulation", "mod", 0, 100, 0));
+            project.RegisterExpression(new UExpressionDescriptor("direct", "dir", 0, 100, 0));
+            project.RegisterExpression(new UExpressionDescriptor("shift", "shft", 0, 100, 0));
+            project.RegisterExpression(new UExpressionDescriptor("attack", "atk", 0, 100, 100));
+            project.RegisterExpression(new UExpressionDescriptor("decay", "dec", 0, 100, 100));
+            project.tracks.Clear();
+            var track = new UTrack("Lead") { TrackNo = 0 };
+            track.Singer = singer;
+            track.Phonemizer = OpenUtau.Api.PhonemizerFactory.Get(typeof(CoeiroinkPhonemizer)).Create();
+            track.RendererSettings.renderer = Renderers.COEIROINK;
+            track.RendererSettings.Validate(track);
+            project.tracks.Add(track);
+            return project;
+        }
+
+        [Fact]
+        public void RendersSungPhraseAtNotePitch() {
+            var bank = Environment.GetEnvironmentVariable(BankVariable);
+            if (string.IsNullOrEmpty(bank) || !Directory.Exists(bank)) {
+                throw new InvalidOperationException("Set COEIROINK_TEST_BANK to an exported bank for this integration test.");
+            }
+            ThreadGuard.SetUiThread(Thread.CurrentThread);
+            System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);
+            var loader = new VoicebankLoader(Path.GetDirectoryName(bank)!);
+            var voicebank = loader.SearchAll().Single(v => Path.GetDirectoryName(v.File) == bank);
+            Assert.Equal(USingerType.Coeiroink, voicebank.SingerType);
+            var singer = new CoeiroinkSinger(voicebank);
+            singer.EnsureLoaded();
+            Assert.Empty(singer.Errors);
+
+            var project = NewProject(singer);
+            var track = project.tracks[0];
+            var part = new UVoicePart { name = "A", trackNo = 0, position = 0, duration = 2400 };
+            project.parts.Add(part);
+            project.timeAxis.BuildSegments(project);
+            var lyrics = new[] { "こ", "ん", "に", "ち", "は", "ね" };
+            var tones = new[] { 60, 62, 64, 62, 60, 62 };
+            for (int i = 0; i < lyrics.Length; i++) {
+                var note = UNote.Create();
+                note.position = i * 360;
+                note.duration = 360;
+                note.tone = tones[i];
+                note.lyric = lyrics[i];
+                note.PositionMs = project.timeAxis.TickPosToMsPos(note.position);
+                note.EndMs = project.timeAxis.TickPosToMsPos(note.End);
+                note.pitch.data = new() { new(-40, 0), new(40, 0) };
+                note.ExtendedDuration = 360;
+                part.notes.Add(note);
+                if (i > 0) {
+                    var previous = part.notes.ElementAt(i - 1);
+                    previous.Next = note;
+                    note.Prev = previous;
+                }
+                var phoneme = new UPhoneme { position = note.position, phoneme = lyrics[i], Parent = note };
+                part.phonemes.Add(phoneme);
+                phoneme.Validate(new ValidateOptions(), project, track, part, note);
+                Assert.False(phoneme.Error, phoneme.ErrorException?.ToString());
+            }
+            var phrases = RenderPhrase.FromPart(project, track, part);
+            Assert.Single(phrases);
+
+            var renderer = new CoeiroinkRenderer();
+            var result = renderer.Render(phrases[0], new Progress(1), 0, new CancellationTokenSource(), false).Result;
+            Assert.NotNull(result.samples);
+            Assert.True(result.samples.Length > 44100 * 0.8);
+            Assert.True(result.samples.Max(Math.Abs) > 0.05f);
+
+            var output = Environment.GetEnvironmentVariable(OutputVariable);
+            if (!string.IsNullOrEmpty(output)) {
+                Format.Wave.WriteMono16Wav(output, result.samples);
+            }
+
+            var f0 = Worldline.F0(result.samples, 44100, 5, 0);
+            double startMs = result.positionMs - result.leadingMs;
+            var measured = new System.Collections.Generic.List<string>();
+            for (int i = 0; i < lyrics.Length; i++) {
+                double centerMs = project.timeAxis.TickPosToMsPos(i * 360 + 220);
+                int frame = (int)((centerMs - startMs) / 5);
+                var window = f0.Skip(frame - 4).Take(9).Where(v => v > 0).ToArray();
+                Assert.NotEmpty(window);
+                double expected = MusicMath.ToneToFreq(tones[i]);
+                double cents = 1200 * Math.Log2(window.OrderBy(v => v).ElementAt(window.Length / 2) / expected);
+                measured.Add($"{lyrics[i]}:{cents:F0}");
+            }
+            Assert.True(measured.All(m => Math.Abs(double.Parse(m.Split(':')[1])) <= 100), string.Join(" ", measured));
+            Assert.All(result.samples, value => Assert.True(float.IsFinite(value)));
+            foreach (var note in part.notes) { note.noteGain = 50; }
+            var quieter = RenderPhrase.FromPart(project, track, part).Single();
+            var half = renderer.Render(quieter, new Progress(1), 0, new CancellationTokenSource(), false).Result;
+            Assert.Equal(result.samples.Length, half.samples.Length);
+            Assert.InRange(result.samples.Zip(half.samples, (a, b) => Math.Abs(a * 0.5f - b)).Max(), 0, 0.0001f);
+            var techniques = new[] { "scoop", "fall", "hammer", "pull", "overshoot", "rise" };
+            for (int i = 0; i < techniques.Length; i++) {
+                var note = part.notes.ElementAt(i);
+                note.pitch = VocalTechniques.Set(note.pitch, note.DurationMs, techniques[i], true);
+            }
+            string settings = Yaml.DefaultSerializer.Serialize(part);
+            var expressive = RenderPhrase.FromPart(project, track, part).Single();
+            Assert.NotEqual(quieter.pitches, expressive.pitches);
+            var expressionAudio = renderer.Render(expressive, new Progress(1), 0, new CancellationTokenSource(), false).Result;
+            Assert.Contains(expressionAudio.samples, v => Math.Abs(v) > 0.01);
+            Assert.Equal(settings, Yaml.DefaultSerializer.Serialize(part));
+            var canceled = new CancellationTokenSource();
+            canceled.Cancel();
+            var noAudio = renderer.Render(expressive, new Progress(1), 0, canceled, false).Result;
+            Assert.Null(noAudio.samples);
+            var projectFile = Environment.GetEnvironmentVariable("COEIROINK_TEST_PROJECT");
+            if (!string.IsNullOrEmpty(projectFile)) {
+                project.ustxVersion = new Version(0, 10);
+                project.BeforeSave();
+                File.WriteAllText(projectFile, Yaml.DefaultSerializer.Serialize(project));
+                project.AfterSave();
+                SingerManager.Inst.Singers[singer.Id] = singer;
+                try {
+                    var loaded = Format.Ustx.Load(projectFile);
+                    var restored = Assert.IsType<UVoicePart>(loaded.parts.Single());
+                    for (int i = 0; i < techniques.Length; i++) {
+                        Assert.Equal(50, restored.notes.ElementAt(i).noteGain);
+                        Assert.True(VocalTechniques.IsEnabled(restored.notes.ElementAt(i).pitch, techniques[i]));
+                    }
+                } finally { SingerManager.Inst.Singers.Remove(singer.Id); }
+            }
+            var color = new UExpressionDescriptor("voice color", Format.Ustx.CLR, 0, 1, 0) {
+                options = new[] { "", singer.Config!.Styles[0].Name },
+            };
+            project.RegisterExpression(color);
+            track.VoiceColorExp = color;
+            foreach (var phone in part.phonemes.Skip(2)) { phone.SetExpression(project, track, Format.Ustx.CLR, 1); }
+            var styled = RenderPhrase.FromPart(project, track, part);
+            Assert.Equal(2, styled.Count);
+            Assert.Equal("", styled[0].phones[0].suffix);
+            Assert.Equal(singer.Config.Styles[0].Name, styled[1].phones[0].suffix);
+        }
+    }
+}
